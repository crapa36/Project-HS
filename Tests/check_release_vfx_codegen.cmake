foreach(required CXX COMPILER_ID CONFIG SOURCE_ROOT FIXTURE_DIRECTORY WORK_DIRECTORY)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required} for the generated VFX contract check")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_DIRECTORY}")
set(arguments)
if(COMPILER_ID STREQUAL "MSVC")
    set(executable "${WORK_DIRECTORY}/vfx-roundtrip.exe")
    list(APPEND arguments /nologo /std:c++latest /Od /EHsc
        "/Fo${WORK_DIRECTORY}/" "/Fe${executable}")
    if(CONFIG STREQUAL "Debug")
        list(APPEND arguments /MDd)
    else()
        list(APPEND arguments /MD)
    endif()
    set(include_prefix /I)
else()
    set(executable "${WORK_DIRECTORY}/vfx-roundtrip")
    list(APPEND arguments -std=c++23 -O0 -o "${executable}")
    set(include_prefix -I)
endif()
foreach(module Core GameDomain RenderData RendererD3D12 Runtime)
    list(APPEND arguments "${include_prefix}${SOURCE_ROOT}/Source/${module}/Public")
endforeach()
list(APPEND arguments "${FIXTURE_DIRECTORY}/release_vfx.fixture.cpp"
    "${FIXTURE_DIRECTORY}/release_vfx.check.cpp")
execute_process(COMMAND "${CXX}" ${arguments} WORKING_DIRECTORY "${WORK_DIRECTORY}"
    RESULT_VARIABLE compiled OUTPUT_VARIABLE output ERROR_VARIABLE errors)
file(WRITE "${WORK_DIRECTORY}/compile.log" "${output}${errors}")
if(NOT compiled EQUAL 0)
    message(FATAL_ERROR "Generated VFX C++ did not compile:\n${output}${errors}")
endif()
execute_process(COMMAND "${executable}" RESULT_VARIABLE checked
    OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT checked EQUAL 0)
    message(FATAL_ERROR "Generated VFX values changed:\n${output}${errors}")
endif()
