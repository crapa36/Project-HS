# Link checks consume the generated, configuration-specific File API graph.
# CMakeLists requests codemodel 2.9 for each configure/generate invocation.
if(NOT DEFINED BUILD_ROOT OR NOT DEFINED CONFIG)
    message(FATAL_ERROR "architecture.layers requires BUILD_ROOT and CONFIG from the generated test")
endif()
set(reply_dir "${BUILD_ROOT}/.cmake/api/v1/reply")
file(GLOB indices "${reply_dir}/index-*.json")
if(NOT indices)
    message(FATAL_ERROR "CMake File API reply is absent; reconfigure and generate this build")
endif()
list(SORT indices ORDER DESCENDING)
list(GET indices 0 index_file)
if(EXISTS "${BUILD_ROOT}/CMakeCache.txt")
    file(TIMESTAMP "${BUILD_ROOT}/CMakeCache.txt" cache_time "%s" UTC)
    file(TIMESTAMP "${index_file}" index_time "%s" UTC)
    if(cache_time GREATER index_time)
        message(FATAL_ERROR "CMake File API reply predates the build cache; regenerate this build")
    endif()
endif()
file(READ "${index_file}" index_json)
string(JSON object_count LENGTH "${index_json}" objects)
set(model_file "")
if(object_count GREATER 0)
    math(EXPR object_last "${object_count} - 1")
    foreach(i RANGE 0 ${object_last})
        string(JSON kind GET "${index_json}" objects ${i} kind)
        if(kind STREQUAL "codemodel")
            string(JSON major GET "${index_json}" objects ${i} version major)
            string(JSON minor GET "${index_json}" objects ${i} version minor)
            if(major EQUAL 2 AND minor GREATER_EQUAL 9)
                string(JSON model_file GET "${index_json}" objects ${i} jsonFile)
                break()
            endif()
        endif()
    endforeach()
endif()
if(NOT model_file)
    message(FATAL_ERROR "CMake File API codemodel 2.9 is absent; regenerate this build")
endif()
file(READ "${reply_dir}/${model_file}" model)
string(JSON model_source GET "${model}" paths source)
string(JSON model_build GET "${model}" paths build)
file(REAL_PATH "${SOURCE_ROOT}" expected_source)
file(REAL_PATH "${BUILD_ROOT}" expected_build)
file(REAL_PATH "${model_source}" model_source)
file(REAL_PATH "${model_build}" model_build)
if(NOT model_source STREQUAL expected_source OR NOT model_build STREQUAL expected_build)
    message(FATAL_ERROR "CMake File API reply belongs to another source/build tree")
endif()
string(JSON configurations LENGTH "${model}" configurations)
set(config_index "")
if(configurations GREATER 0)
    math(EXPR config_last "${configurations} - 1")
    foreach(i RANGE 0 ${config_last})
        string(JSON name GET "${model}" configurations ${i} name)
        if(name STREQUAL CONFIG)
            set(config_index ${i})
            break()
        endif()
    endforeach()
endif()
if(config_index STREQUAL "")
    message(FATAL_ERROR "CMake File API has no generated configuration '${CONFIG}'")
endif()

# 2.9 includes source-less INTERFACE and imported targets in abstractTargets.
foreach(group IN ITEMS targets abstractTargets)
    string(JSON target_count ERROR_VARIABLE missing LENGTH "${model}" configurations ${config_index} ${group})
    if(missing OR target_count EQUAL 0)
        continue()
    endif()
    math(EXPR target_last "${target_count} - 1")
    foreach(i RANGE 0 ${target_last})
        string(JSON target_id GET "${model}" configurations ${config_index} ${group} ${i} id)
        string(JSON target_name GET "${model}" configurations ${config_index} ${group} ${i} name)
        string(JSON target_file GET "${model}" configurations ${config_index} ${group} ${i} jsonFile)
        string(SHA256 key "${target_id}")
        file(READ "${reply_dir}/${target_file}" "hs_target_${key}")
        set("hs_name_${key}" "${target_name}")
        if(target_name MATCHES "^(hs_|ProjectHS$)")
            if(DEFINED "hs_id_${target_name}" AND NOT "${hs_id_${target_name}}" STREQUAL "${target_id}")
                message(FATAL_ERROR "Ambiguous project target in CMake File API: ${target_name}")
            endif()
            set("hs_id_${target_name}" "${target_id}")
        endif()
    endforeach()
endforeach()
if(NOT DEFINED hs_id_hs_core)
    message(FATAL_ERROR "CMake File API codemodel does not contain the project targets")
endif()

function(hs_target_edges target_id member result)
    string(SHA256 key "${target_id}")
    if(NOT DEFINED "hs_target_${key}")
        message(FATAL_ERROR "CMake File API target ${target_id} is missing")
    endif()
    set(json "${hs_target_${key}}")
    string(JSON count ERROR_VARIABLE missing LENGTH "${json}" ${member})
    set(edges "")
    if(NOT missing AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE 0 ${last})
            string(JSON edge ERROR_VARIABLE no_id GET "${json}" ${member} ${i} id)
            if(NOT no_id)
                list(APPEND edges "${edge}")
            endif()
        endforeach()
    endif()
    set(${result} "${edges}" PARENT_SCOPE)
endfunction()

function(hs_reject_target_links target)
    if(NOT DEFINED "hs_id_${target}")
        return() # Target is genuinely absent in this build configuration.
    endif()
    set(root "${hs_id_${target}}")
    # Keep link and compile-only usage requirements distinct. A dependency's
    # private implementation edges do not propagate to its consumers.
    foreach(kind IN ITEMS link compile)
        if(kind STREQUAL "link")
            set(direct_member linkLibraries)
            set(interface_member interfaceLinkLibraries)
        else()
            set(direct_member compileDependencies)
            set(interface_member interfaceCompileDependencies)
        endif()
        hs_target_edges("${root}" ${direct_member} queue)
        hs_target_edges("${root}" ${interface_member} declared_interface)
        list(APPEND queue ${declared_interface})
        set(visited "")
        while(queue)
            list(POP_FRONT queue current)
            if(current IN_LIST visited)
                continue()
            endif()
            list(APPEND visited "${current}")
            string(SHA256 key "${current}")
            if(NOT DEFINED "hs_name_${key}")
                message(FATAL_ERROR "CMake File API ${kind} target ${current} is absent from its codemodel")
            endif()
            set(name "${hs_name_${key}}")
            if(name IN_LIST ARGN)
                message(FATAL_ERROR "${target} has forbidden ${kind} dependency ${name} (directly or through its interface)")
            endif()
            hs_target_edges("${current}" ${interface_member} next)
            list(APPEND queue ${next})
        endwhile()
    endforeach()
endfunction()

