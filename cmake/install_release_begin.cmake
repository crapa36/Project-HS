# Keep every existing Runtime install rule inside one unpublished sibling tree.
set(_hs_release_final_prefix "${CMAKE_INSTALL_PREFIX}")
set(_hs_release_final_destdir "$ENV{DESTDIR}")
file(TO_CMAKE_PATH "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}" _hs_release_target)
cmake_path(NORMAL_PATH _hs_release_target)
if(NOT IS_ABSOLUTE "${_hs_release_target}")
    message(FATAL_ERROR "Release install prefix must be absolute: ${_hs_release_target}")
endif()
get_filename_component(_hs_release_parent "${_hs_release_target}" DIRECTORY)
get_filename_component(_hs_release_name "${_hs_release_target}" NAME)
if(_hs_release_name STREQUAL "" OR _hs_release_parent STREQUAL _hs_release_target)
    message(FATAL_ERROR "Release install requires a named destination directory")
endif()
set(_hs_release_stage "${_hs_release_parent}/.${_hs_release_name}.staging")
set(_hs_release_parked "${_hs_release_parent}/.${_hs_release_name}.empty-before-publish")
file(MAKE_DIRECTORY "${_hs_release_parent}")
file(LOCK "${_hs_release_parent}/.${_hs_release_name}.install.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Another Release install is publishing this destination: ${_hs_release_target}")
endif()

function(hs_release_directory_state path result)
    if(IS_SYMLINK "${path}")
        set(${result} unsafe PARENT_SCOPE)
    elseif(NOT EXISTS "${path}")
        set(${result} missing PARENT_SCOPE)
    elseif(NOT IS_DIRECTORY "${path}")
        set(${result} unsafe PARENT_SCOPE)
    else()
        file(GLOB children LIST_DIRECTORIES true "${path}/*" "${path}/.*")
        list(FILTER children EXCLUDE REGEX "/\\.\\.?$")
        if(children)
            set(${result} nonempty PARENT_SCOPE)
        else()
            set(${result} empty PARENT_SCOPE)
        endif()
    endif()
endfunction()

hs_release_directory_state("${_hs_release_target}" target_state)
if(NOT target_state STREQUAL "missing" AND NOT target_state STREQUAL "empty")
    message(FATAL_ERROR "Release install destination is not missing or empty: ${_hs_release_target}")
endif()
if(EXISTS "${_hs_release_stage}" OR IS_SYMLINK "${_hs_release_stage}" OR
        EXISTS "${_hs_release_parked}" OR IS_SYMLINK "${_hs_release_parked}")
    message(FATAL_ERROR "Interrupted Release install left a sibling stage; inspect ${_hs_release_stage} and ${_hs_release_parked} before retrying")
endif()
file(MAKE_DIRECTORY "${_hs_release_stage}")
set(ENV{DESTDIR} "")
set(CMAKE_INSTALL_PREFIX "${_hs_release_stage}")
