foreach(required IN ITEMS ProjectHS.exe Content/content.hsp D3D12/D3D12Core.dll
        Licenses/NotoSansKR-OFL.txt ThirdPartyNotices.txt)
    if(NOT EXISTS "${_hs_release_stage}/${required}")
        message(FATAL_ERROR "Incomplete staged Release: ${required}; stage retained at ${_hs_release_stage}")
    endif()
endforeach()
function(hs_release_verify_copy source staged)
    if(NOT EXISTS "${source}" OR NOT EXISTS "${staged}")
        message(FATAL_ERROR "Cannot verify staged Release copy: ${source} -> ${staged}; stage retained at ${_hs_release_stage}")
    endif()
    file(SHA256 "${source}" source_hash)
    file(SHA256 "${staged}" staged_hash)
    if(NOT source_hash STREQUAL staged_hash)
        message(FATAL_ERROR "Staged Release copy differs from built source: ${staged}; stage retained at ${_hs_release_stage}")
    endif()
endfunction()
hs_release_verify_copy("${_hs_release_source_exe}" "${_hs_release_stage}/ProjectHS.exe")
hs_release_verify_copy("${_hs_release_source_pack}" "${_hs_release_stage}/Content/content.hsp")

# An empty destination is parked first. The final rename never replaces a directory.
hs_release_directory_state("${_hs_release_target}" target_state)
if(target_state STREQUAL "empty")
    file(RENAME "${_hs_release_target}" "${_hs_release_parked}" NO_REPLACE RESULT park_result)
    if(NOT park_result STREQUAL "0")
        message(FATAL_ERROR "Cannot park empty Release destination: ${park_result}; stage retained at ${_hs_release_stage}")
    endif()
    hs_release_directory_state("${_hs_release_parked}" parked_state)
    if(NOT parked_state STREQUAL "empty")
        file(RENAME "${_hs_release_parked}" "${_hs_release_target}" NO_REPLACE RESULT restore_result)
        message(FATAL_ERROR "Release destination changed before publish; restore=${restore_result}; stage retained at ${_hs_release_stage}")
    endif()
elseif(NOT target_state STREQUAL "missing")
    message(FATAL_ERROR "Release destination changed before publish; stage retained at ${_hs_release_stage}")
endif()

file(RENAME "${_hs_release_stage}" "${_hs_release_target}" NO_REPLACE RESULT publish_result)
if(NOT publish_result STREQUAL "0")
    if(EXISTS "${_hs_release_parked}" AND NOT EXISTS "${_hs_release_target}")
        file(RENAME "${_hs_release_parked}" "${_hs_release_target}" NO_REPLACE RESULT restore_result)
    endif()
    message(FATAL_ERROR "Release publish failed (${publish_result}); stage retained at ${_hs_release_stage}")
endif()
if(EXISTS "${_hs_release_parked}")
    hs_release_directory_state("${_hs_release_parked}" parked_state)
    if(parked_state STREQUAL "empty")
        file(REMOVE_RECURSE "${_hs_release_parked}")
    else()
        message(FATAL_ERROR "Release published, but parked destination is nonempty: ${_hs_release_parked}")
    endif()
endif()

# CMake records paths while installing into the stage; report their published paths.
string(LENGTH "${_hs_release_stage}" stage_length)
set(published_files)
foreach(installed IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
    string(SUBSTRING "${installed}" 0 ${stage_length} path_prefix)
    if(path_prefix STREQUAL _hs_release_stage)
        string(SUBSTRING "${installed}" ${stage_length} -1 path_suffix)
        list(APPEND published_files "${_hs_release_target}${path_suffix}")
    else()
        list(APPEND published_files "${installed}")
    endif()
endforeach()
set(CMAKE_INSTALL_MANIFEST_FILES "${published_files}")
set(CMAKE_INSTALL_PREFIX "${_hs_release_final_prefix}")
set(ENV{DESTDIR} "${_hs_release_final_destdir}")
