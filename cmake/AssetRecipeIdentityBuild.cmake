cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS HS_RECIPE_DESCRIPTOR HS_RECIPE_MANIFEST)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Asset recipe identity requires ${required}")
    endif()
endforeach()
if(NOT EXISTS "${HS_RECIPE_DESCRIPTOR}")
    message(FATAL_ERROR "Asset recipe identity descriptor is missing: ${HS_RECIPE_DESCRIPTOR}")
endif()
include("${HS_RECIPE_DESCRIPTOR}")

foreach(required IN ITEMS HS_RECIPE_PRODUCER HS_RECIPE_SOURCE_ROOT HS_RECIPE_BINARY_ROOT
        HS_RECIPE_NINJA HS_RECIPE_COMPILE_DATABASE HS_RECIPE_COMPILER
        HS_RECIPE_POINTER_SIZE HS_RECIPE_PRODUCER_OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Asset recipe descriptor is missing ${required}")
    endif()
endforeach()
if(NOT EXISTS "${HS_RECIPE_COMPILE_DATABASE}")
    message(FATAL_ERROR
        "Asset recipe identity requires compile_commands.json after producer build: "
        "${HS_RECIPE_COMPILE_DATABASE}")
endif()
if(NOT EXISTS "${HS_RECIPE_NINJA}")
    message(FATAL_ERROR "Asset recipe identity requires Ninja: ${HS_RECIPE_NINJA}")
endif()

function(_hs_recipe_abs_path output path base_directory)
    set(value "${path}")
    if(NOT IS_ABSOLUTE "${value}")
        cmake_path(ABSOLUTE_PATH value BASE_DIRECTORY "${base_directory}" NORMALIZE)
    else()
        cmake_path(NORMAL_PATH value)
    endif()
    if(EXISTS "${value}")
        # MSVC emits lower-case paths; resolve actual filesystem spelling so
        # source membership, SDK ownership and header dedup share one identity.
        file(REAL_PATH "${value}" value)
    endif()
    string(REPLACE "\\" "/" value "${value}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_hs_recipe_is_prefix output root path)
    set(root_value "${root}")
    set(path_value "${path}")
    string(REPLACE "\\" "/" root_value "${root_value}")
    string(REPLACE "\\" "/" path_value "${path_value}")
    cmake_path(IS_PREFIX root_value "${path_value}" NORMALIZE result)
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(_hs_recipe_json_escape output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    set(${output} "${escaped}" PARENT_SCOPE)
endfunction()

function(_hs_recipe_is_compilable_source output path)
    get_filename_component(extension "${path}" LAST_EXT)
    string(TOLOWER "${extension}" extension)
    if(extension MATCHES "^\\.(c|cc|cpp|cxx|m|mm)$")
        set(result TRUE)
    else()
        set(result FALSE)
    endif()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(_hs_recipe_is_sdk_source output path)
    set(sdk_root "${HS_RECIPE_BINARY_ROOT}/_deps")
    _hs_recipe_is_prefix(in_sdk_root "${sdk_root}" "${path}")
    if(in_sdk_root)
        file(RELATIVE_PATH relative "${sdk_root}" "${path}")
        if(relative MATCHES "^[^/]+-src(/|$)")
            set(result TRUE)
        else()
            set(result FALSE)
        endif()
    else()
        set(result FALSE)
    endif()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(_hs_recipe_logical_id output path)
    set(logical "")
    # The build tree is nested in the source tree for this project. Classify
    # SDK and generated paths before testing the source root, or they would be
    # assigned source-relative IDs.
    set(sdk_root "${HS_RECIPE_BINARY_ROOT}/_deps")
    _hs_recipe_is_prefix(in_sdk_source_root "${sdk_root}" "${path}")
    if(in_sdk_source_root)
        file(RELATIVE_PATH relative "${sdk_root}" "${path}")
        if(relative MATCHES "^[^/]+-src(/|$)")
            set(logical "sdk-source/${relative}")
        endif()
    endif()
    if(NOT logical)
        _hs_recipe_is_prefix(in_build "${HS_RECIPE_BINARY_ROOT}" "${path}")
        if(in_build)
            file(RELATIVE_PATH relative "${HS_RECIPE_BINARY_ROOT}" "${path}")
            set(logical "sdk-generated/${relative}")
        endif()
    endif()
    if(NOT logical)
        foreach(root_entry IN LISTS HS_RECIPE_EXTERNAL_HEADER_ROOTS)
            string(FIND "${root_entry}" "|" separator)
            if(separator GREATER -1)
                string(SUBSTRING "${root_entry}" 0 ${separator} owner)
                math(EXPR directory_start "${separator} + 1")
                string(SUBSTRING "${root_entry}" ${directory_start} -1 directory)
                _hs_recipe_is_prefix(in_directory "${directory}" "${path}")
                if(in_directory)
                    file(RELATIVE_PATH relative "${directory}" "${path}")
                    set(logical "sdk-header/${owner}/${relative}")
                    break()
                endif()
            endif()
        endforeach()
    endif()
    if(NOT logical)
        _hs_recipe_is_prefix(in_source "${HS_RECIPE_SOURCE_ROOT}" "${path}")
        if(in_source)
            file(RELATIVE_PATH relative "${HS_RECIPE_SOURCE_ROOT}" "${path}")
            set(logical "${relative}")
        endif()
    endif()
    if(NOT logical)
        get_filename_component(filename "${path}" NAME)
        get_filename_component(extension "${path}" LAST_EXT)
        string(TOLOWER "${extension}" extension)
        if(extension MATCHES "^\\.(a|dll|dylib|exe|lib|so)$")
            set(logical "sdk-binary/${filename}")
        else()
            set(logical "sdk-header/implicit/${filename}")
        endif()
    endif()
    string(REPLACE "\\" "/" logical "${logical}")
    set(${output} "${logical}" PARENT_SCOPE)
endfunction()

file(READ "${HS_RECIPE_COMPILE_DATABASE}" compile_database)
string(JSON compile_count LENGTH "${compile_database}")
if(compile_count LESS 1)
    message(FATAL_ERROR "Asset recipe compile database is empty: ${HS_RECIPE_COMPILE_DATABASE}")
endif()
math(EXPR compile_last "${compile_count} - 1")
set(compile_sources)
set(compile_outputs)
set(compile_commands)
foreach(index RANGE 0 ${compile_last})
    string(JSON source GET "${compile_database}" ${index} file)
    string(JSON output GET "${compile_database}" ${index} output)
    string(JSON directory GET "${compile_database}" ${index} directory)
    string(JSON command ERROR_VARIABLE command_error GET "${compile_database}" ${index} command)
    if(command_error)
        set(command "")
    endif()
    _hs_recipe_abs_path(source_path "${source}" "${directory}")
    _hs_recipe_abs_path(output_path "${output}" "${directory}")
    list(APPEND compile_sources "${source_path}")
    list(APPEND compile_outputs "${output_path}")
    list(APPEND compile_commands "${command}")
endforeach()

if(NOT DEFINED HS_RECIPE_TARGET_COUNT OR HS_RECIPE_TARGET_COUNT LESS 1)
    message(FATAL_ERROR "Asset recipe descriptor has no evaluated target closure")
endif()
set(input_paths)
set(selected_commands)
set(target_index 0)
foreach(target IN LISTS HS_RECIPE_TARGET_NAMES)
    string(APPEND HS_RECIPE_BUILD_OPTIONS "\ntarget-membership:${target}")
    set(source_dir_var "HS_RECIPE_TARGET_SOURCE_DIR_${target_index}")
    set(source_dir "${${source_dir_var}}")
    if(NOT source_dir OR source_dir MATCHES "-NOTFOUND$")
        set(source_dir "${HS_RECIPE_SOURCE_ROOT}")
    endif()

    set(source_var "HS_RECIPE_TARGET_SOURCES_${target_index}")
    set(sources "${${source_var}}")
    foreach(source IN LISTS sources)
        if(source STREQUAL "" OR source MATCHES "\\$<" OR source MATCHES "-NOTFOUND$")
            continue()
        endif()
        _hs_recipe_abs_path(source "${source}" "${source_dir}")
        _hs_recipe_is_prefix(in_build "${HS_RECIPE_BINARY_ROOT}" "${source}")
        _hs_recipe_is_sdk_source(in_sdk_source "${source}")
        # Generated project files are represented by authored SDK inputs and
        # actual compiler deps. Their configure-time source path is unstable.
        if(in_build AND NOT in_sdk_source)
            continue()
        endif()
        list(APPEND input_paths "${source}")
        _hs_recipe_is_compilable_source(compilable "${source}")
        if(NOT compilable)
            continue()
        endif()

        set(found FALSE)
        list(LENGTH compile_sources record_count)
        math(EXPR record_last "${record_count} - 1")
        foreach(index RANGE 0 ${record_last})
            list(GET compile_sources ${index} candidate_source)
            if(NOT "${candidate_source}" STREQUAL "${source}")
                continue()
            endif()
            list(GET compile_outputs ${index} candidate_output)
            string(REPLACE "\\" "/" output_for_match "${candidate_output}")
            set(record_target)
            foreach(candidate_target IN LISTS HS_RECIPE_TARGET_NAMES)
                if(output_for_match MATCHES "(^|/)CMakeFiles/${candidate_target}\\.dir/")
                    set(record_target "${candidate_target}")
                    break()
                endif()
            endforeach()
            if(record_target)
                # A source exposed by an interface target is compiled by its
                # consumer. Match the object against the evaluated closure,
                # rather than assuming the property owner owns the object.
                set(found TRUE)
                if(NOT EXISTS "${candidate_output}")
                    message(FATAL_ERROR
                        "Ninja dependency record is stale because its object is missing: ${candidate_output}")
                endif()
                if(HS_RECIPE_COMPILER MATCHES "^MSVC-")
                    set(dependency_file "${candidate_output}.hsdeps.json")
                    if(NOT EXISTS "${dependency_file}")
                        message(FATAL_ERROR "Completed compiler dependency snapshot is missing: ${dependency_file}")
                    endif()
                    file(READ "${dependency_file}" dependency_json)
                    string(JSON dependency_version GET "${dependency_json}" Version)
                    if(NOT dependency_version MATCHES "^1\\.[12]$")
                        message(FATAL_ERROR "Unsupported MSVC dependency snapshot version: ${dependency_version}")
                    endif()
                    string(JSON dependency_source GET "${dependency_json}" Data Source)
                    _hs_recipe_abs_path(dependency_source "${dependency_source}" "${HS_RECIPE_BINARY_ROOT}")
                    if(NOT dependency_source STREQUAL source)
                        message(FATAL_ERROR "Compiler dependency snapshot belongs to another source: ${dependency_file}")
                    endif()
                    string(JSON include_count LENGTH "${dependency_json}" Data Includes)
                    if(include_count GREATER 0)
                        math(EXPR include_last "${include_count} - 1")
                        foreach(include_index RANGE 0 ${include_last})
                            string(JSON dep_path GET "${dependency_json}" Data Includes ${include_index})
                            _hs_recipe_abs_path(dep_path "${dep_path}" "${HS_RECIPE_BINARY_ROOT}")
                            if(NOT EXISTS "${dep_path}" OR IS_DIRECTORY "${dep_path}")
                                message(FATAL_ERROR "Compiler dependency snapshot names a missing input: ${dep_path}")
                            endif()
                            list(APPEND input_paths "${dep_path}")
                        endforeach()
                    endif()
                    # Imported modules/header units need their own authored
                    # closure. Current producer targets do not import either.
                    foreach(import_kind IN ITEMS ImportedModules ImportedHeaderUnits)
                        string(JSON imported_count ERROR_VARIABLE imported_error LENGTH
                            "${dependency_json}" Data ${import_kind})
                        if(NOT imported_error AND imported_count GREATER 0)
                            message(FATAL_ERROR "Asset recipe module dependency closure is unsupported: ${dependency_file}")
                        endif()
                    endforeach()
                else()
                file(RELATIVE_PATH object_argument "${HS_RECIPE_BINARY_ROOT}" "${candidate_output}")
                string(REPLACE "\\" "/" object_argument "${object_argument}")
                execute_process(
                    COMMAND "${HS_RECIPE_NINJA}" -C "${HS_RECIPE_BINARY_ROOT}" -t deps "${object_argument}"
                    RESULT_VARIABLE deps_result
                    OUTPUT_VARIABLE deps_output
                    ERROR_VARIABLE deps_error)
                if(NOT deps_result EQUAL 0)
                    message(FATAL_ERROR
                        "ninja -t deps failed for ${candidate_output} (${deps_result}): ${deps_error}")
                endif()
                string(REPLACE "\r\n" "\n" deps_output "${deps_output}")
                string(REPLACE "\r" "\n" deps_output "${deps_output}")
                string(REPLACE "\n" ";" deps_lines "${deps_output}")
                list(GET deps_lines 0 deps_header)
                if(NOT deps_header MATCHES "#deps ([0-9]+).*\\(VALID\\)")
                    message(FATAL_ERROR
                        "Ninja dependency record is absent or stale for ${candidate_output}: ${deps_header}")
                endif()
                set(expected_deps "${CMAKE_MATCH_1}")
                set(actual_deps 0)
                foreach(dep_line IN LISTS deps_lines)
                    string(STRIP "${dep_line}" dep_line)
                    if(dep_line STREQUAL "" OR dep_line MATCHES "#deps [0-9]+")
                        continue()
                    endif()
                    _hs_recipe_abs_path(dep_path "${dep_line}" "${HS_RECIPE_BINARY_ROOT}")
                    if(NOT EXISTS "${dep_path}" OR IS_DIRECTORY "${dep_path}")
                        message(FATAL_ERROR
                            "Ninja dependency record names a missing input for ${candidate_output}: ${dep_path}")
                    endif()
                    list(APPEND input_paths "${dep_path}")
                    math(EXPR actual_deps "${actual_deps} + 1")
                endforeach()
                if(actual_deps LESS expected_deps)
                    message(FATAL_ERROR
                        "Ninja dependency record is incomplete for ${candidate_output}: "
                        "expected ${expected_deps}, parsed ${actual_deps}")
                endif()
                endif()
                list(GET compile_commands ${index} selected_command)
                if(selected_command)
                    string(REPLACE "\\" "/" selected_command "${selected_command}")
                    list(APPEND selected_commands "${record_target}:${selected_command}")
                endif()
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR
                "compile_commands.json has no object mapping for ${target}:${source}; "
                "configure with CMAKE_EXPORT_COMPILE_COMMANDS=ON")
        endif()
    endforeach()
    math(EXPR target_index "${target_index} + 1")
endforeach()

# Compiler options, definitions, and include ordering are taken from the
# evaluated compile_commands records above. Capture the producer's post-build
# linker command from Ninja as emitted, so link flags are not reconstructed
# from configuration-time genex values or lossy property parsing.
execute_process(
    COMMAND "${HS_RECIPE_NINJA}" -C "${HS_RECIPE_BINARY_ROOT}" -t commands "${HS_RECIPE_PRODUCER}"
    RESULT_VARIABLE link_commands_result
    OUTPUT_VARIABLE link_commands_output
    ERROR_VARIABLE link_commands_error)
if(NOT link_commands_result EQUAL 0)
    message(FATAL_ERROR
        "ninja -t commands failed for ${HS_RECIPE_PRODUCER} (${link_commands_result}): "
        "${link_commands_error}")
endif()
string(REPLACE "\r\n" "\n" link_commands_output "${link_commands_output}")
string(REPLACE "\r" "\n" link_commands_output "${link_commands_output}")
string(REPLACE "\n" ";" link_command_lines "${link_commands_output}")
get_filename_component(producer_output_name "${HS_RECIPE_PRODUCER_OUTPUT}" NAME)
string(TOLOWER "${producer_output_name}" producer_output_name)
set(all_link_commands)
set(producer_link_commands)
foreach(link_command IN LISTS link_command_lines)
    string(STRIP "${link_command}" link_command)
    if(link_command STREQUAL "")
        continue()
    endif()
    string(TOLOWER "${link_command}" link_command_lower)
    if(link_command_lower MATCHES "(^|[ \"/\\\\])(link|lld-link|lib)(\\.exe)?([ \"/]|$)")
        list(APPEND all_link_commands "${link_command}")
        if(producer_output_name AND link_command_lower MATCHES "${producer_output_name}")
            list(APPEND producer_link_commands "${link_command}")
        endif()
    endif()
endforeach()
if(producer_link_commands)
    list(GET producer_link_commands -1 producer_link_command)
elseif(all_link_commands)
    # The producer edge is last in Ninja's transitive command listing when its
    # output name is not spelled literally in the linker command.
    list(GET all_link_commands -1 producer_link_command)
else()
    message(FATAL_ERROR
        "ninja -t commands produced no linker command for ${HS_RECIPE_PRODUCER}")
endif()
string(REPLACE "\\" "/" producer_link_command "${producer_link_command}")
string(APPEND HS_RECIPE_BUILD_OPTIONS "\nlink-command:${producer_link_command}")

foreach(path IN LISTS HS_RECIPE_AUTHORED_INPUTS HS_RECIPE_SDK_BINARIES)
    _hs_recipe_abs_path(path "${path}" "${HS_RECIPE_SOURCE_ROOT}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Asset recipe authored or SDK input is missing: ${path}")
    endif()
    list(APPEND input_paths "${path}")
endforeach()
list(REMOVE_DUPLICATES input_paths)
list(SORT input_paths)

set(entries)
set(logical_ids)
foreach(path IN LISTS input_paths)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Asset recipe identity input is not a regular file: ${path}")
    endif()
    _hs_recipe_is_sdk_source(in_sdk_source "${path}")
    _hs_recipe_is_prefix(in_build "${HS_RECIPE_BINARY_ROOT}" "${path}")
    if(in_build AND NOT in_sdk_source)
        # Build-generated headers and shader .inc files are represented by the
        # authored SDK shader inputs recorded in HS_RECIPE_AUTHORED_INPUTS.
        continue()
    endif()
    _hs_recipe_logical_id(logical "${path}")
    list(FIND logical_ids "${logical}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Duplicate recipe input logical ID '${logical}' for ${path}")
    endif()
    list(APPEND logical_ids "${logical}")
    string(REPLACE "\\" "/" path_for_json "${path}")
    _hs_recipe_json_escape(logical_json "${logical}")
    _hs_recipe_json_escape(path_json "${path_for_json}")
    list(APPEND entries "{\"logical_id\":\"${logical_json}\",\"path\":\"${path_json}\"}")
endforeach()
if(NOT entries)
    message(FATAL_ERROR "Asset recipe identity has no implementation inputs for ${HS_RECIPE_PRODUCER}")
endif()
list(SORT entries)
list(JOIN entries ",\n" entries_json)

set(normalized_options "${HS_RECIPE_BUILD_OPTIONS}")
foreach(command IN LISTS selected_commands)
    string(APPEND normalized_options "\ncompiler-command:${command}")
endforeach()
string(REPLACE "\\" "/" source_root_for_options "${HS_RECIPE_SOURCE_ROOT}")
string(REPLACE "\\" "/" binary_root_for_options "${HS_RECIPE_BINARY_ROOT}")
string(REPLACE "${binary_root_for_options}" "<build-root>" normalized_options "${normalized_options}")
string(REPLACE "${source_root_for_options}" "<source-root>" normalized_options "${normalized_options}")
_hs_recipe_json_escape(configuration_json "${HS_RECIPE_CONFIGURATION}")
_hs_recipe_json_escape(compiler_json "${HS_RECIPE_COMPILER}")
_hs_recipe_json_escape(options_json "${normalized_options}")
string(CONCAT manifest_content
    "{\"schema_version\":1,\"source_text_normalization\":\"crlf-to-lf\","
    "\"producer\":\"${HS_RECIPE_PRODUCER}\","
    "\"configuration\":\"${configuration_json}\","
    "\"compiler\":\"${compiler_json}\","
    "\"pointer_size\":${HS_RECIPE_POINTER_SIZE},"
    "\"build_options\":\"${options_json}\","
    "\"inputs\":[${entries_json}]}\n")

get_filename_component(manifest_directory "${HS_RECIPE_MANIFEST}" DIRECTORY)
file(MAKE_DIRECTORY "${manifest_directory}")
set(previous_manifest)
if(EXISTS "${HS_RECIPE_MANIFEST}")
    file(READ "${HS_RECIPE_MANIFEST}" previous_manifest)
endif()
if(previous_manifest STREQUAL manifest_content)
    return()
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef temporary_suffix)
set(temporary_manifest "${HS_RECIPE_MANIFEST}.tmp-${temporary_suffix}")
file(WRITE "${temporary_manifest}" "${manifest_content}")
file(RENAME "${temporary_manifest}" "${HS_RECIPE_MANIFEST}" RESULT rename_error)
if(rename_error)
    file(REMOVE "${temporary_manifest}")
    message(FATAL_ERROR "Cannot atomically publish recipe identity ${HS_RECIPE_MANIFEST}: ${rename_error}")
endif()
