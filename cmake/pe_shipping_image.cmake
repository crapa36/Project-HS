function(_hs_pe_u16 hex offset result)
    set(value 0)
    foreach(index RANGE 0 1)
        math(EXPR byte_offset "${offset} + ${index} * 2")
        string(SUBSTRING "${hex}" ${byte_offset} 2 byte_hex)
        math(EXPR byte "0x${byte_hex}")
        math(EXPR value "${value} | (${byte} << (${index} * 8))")
    endforeach()
    set(${result} "${value}" PARENT_SCOPE)
endfunction()

function(_hs_pe_u32 hex offset result)
    set(value 0)
    foreach(index RANGE 0 3)
        math(EXPR byte_offset "${offset} + ${index} * 2")
        string(SUBSTRING "${hex}" ${byte_offset} 2 byte_hex)
        math(EXPR byte "0x${byte_hex}")
        math(EXPR value "${value} | (${byte} << (${index} * 8))")
    endforeach()
    set(${result} "${value}" PARENT_SCOPE)
endfunction()

function(hs_pe_read_shipping_image executable header_result size_result)
    file(SIZE "${executable}" executable_size)
    if(executable_size LESS 64)
        message(FATAL_ERROR "Release executable is too short to contain a PE image: ${executable}")
    endif()
    file(READ "${executable}" dos_header HEX OFFSET 0 LIMIT 64)
    if(NOT dos_header MATCHES "^4d5a")
        message(FATAL_ERROR "Release executable has no DOS/PE signature: ${executable}")
    endif()
    _hs_pe_u32("${dos_header}" 120 pe_offset)
    math(EXPR coff_end "${pe_offset} + 24")
    if(coff_end GREATER executable_size)
        message(FATAL_ERROR "Release executable has a truncated PE header: ${executable}")
    endif()
    file(READ "${executable}" pe_signature HEX OFFSET ${pe_offset} LIMIT 4)
    if(NOT pe_signature STREQUAL "50450000")
        message(FATAL_ERROR "Release executable has an invalid PE signature: ${executable}")
    endif()
    file(READ "${executable}" coff_header HEX OFFSET ${pe_offset} LIMIT 24)
    _hs_pe_u16("${coff_header}" 12 section_count)
    _hs_pe_u16("${coff_header}" 40 optional_header_size)
    math(EXPR sections_offset "${pe_offset} + 24 + ${optional_header_size}")
    math(EXPR sections_end "${sections_offset} + ${section_count} * 40")
    if(section_count LESS 1 OR sections_end GREATER executable_size)
        message(FATAL_ERROR "Release executable has an invalid PE section table: ${executable}")
    endif()

    set(image_header)
    foreach(section_index RANGE 0 ${section_count})
        if(section_index EQUAL section_count)
            break()
        endif()
        math(EXPR section_offset "${sections_offset} + ${section_index} * 40")
        file(READ "${executable}" section_header HEX OFFSET ${section_offset} LIMIT 40)
        string(SUBSTRING "${section_header}" 0 16 section_name)
        if(section_name STREQUAL "2e6873696d616765")
            _hs_pe_u32("${section_header}" 32 raw_size)
            _hs_pe_u32("${section_header}" 40 raw_offset)
            math(EXPR raw_end "${raw_offset} + 64")
            if(raw_size LESS 64 OR raw_offset LESS sections_end OR raw_end GREATER executable_size)
                message(FATAL_ERROR "Release executable has a truncated .hsimage section: ${executable}")
            endif()
            file(READ "${executable}" image_header HEX OFFSET ${raw_offset} LIMIT 64)
            string(LENGTH "${image_header}" image_header_length)
            if(NOT image_header_length EQUAL 128)
                message(FATAL_ERROR "Release executable has an invalid .hsimage header: ${executable}")
            endif()
            break()
        endif()
    endforeach()
    if(NOT image_header)
        message(FATAL_ERROR "Release executable has no linked .hsimage section: ${executable}")
    endif()

    set(image_size 0)
    foreach(index RANGE 0 7)
        math(EXPR byte_offset "96 + ${index} * 2")
        string(SUBSTRING "${image_header}" ${byte_offset} 2 byte_hex)
        math(EXPR byte "0x${byte_hex}")
        math(EXPR image_size "${image_size} | (${byte} << (${index} * 8))")
    endforeach()
    if(image_size LESS 64)
        message(FATAL_ERROR "Release executable contains an invalid .hsimage extent: ${executable}")
    endif()
    set(${header_result} "${image_header}" PARENT_SCOPE)
    set(${size_result} "${image_size}" PARENT_SCOPE)
endfunction()
