cmake_minimum_required(VERSION 3.25)

# Arguments after -- preserve the configured launcher/compiler command. The
# projector identity is part of that command so edits invalidate Ninja objects.
# CMake lists cannot represent an argument ending in a backslash (for example
# /Fd<directory>\). Bracket literals preserve each original argument exactly.
function(_hs_quote_msvc_argument output value)
    set(equals)
    while(TRUE)
        string(FIND "${value}" "]${equals}]" closing_position)
        if(closing_position EQUAL -1)
            break()
        endif()
        string(APPEND equals "=")
    endwhile()
    set(${output} "[${equals}[${value}]${equals}]" PARENT_SCOPE)
endfunction()
set(compiler_code "execute_process(COMMAND")
set(has_command FALSE)
set(object_file)
set(dependency_file)
set(in_command FALSE)
set(expect_dependency_file FALSE)
set(expect_object_file FALSE)
math(EXPR last_argument "${CMAKE_ARGC} - 1")
foreach(index RANGE 0 ${last_argument})
    set(argument "${CMAKE_ARGV${index}}")
    if(NOT in_command)
        if(argument STREQUAL "--")
            set(in_command TRUE)
        endif()
        continue()
    endif()
    string(TOLOWER "${argument}" argument_lower)
    if(argument_lower STREQUAL "/showincludes" OR argument_lower STREQUAL "-showincludes")
        continue()
    endif()
    _hs_quote_msvc_argument(quoted_argument "${argument}")
    string(APPEND compiler_code " ${quoted_argument}")
    set(has_command TRUE)
    if(expect_dependency_file)
        set(dependency_file "${argument}")
        set(expect_dependency_file FALSE)
    elseif(argument_lower STREQUAL "/sourcedependencies" OR argument_lower STREQUAL "-sourcedependencies")
        set(expect_dependency_file TRUE)
    elseif(expect_object_file)
        set(object_file "${argument}")
        set(expect_object_file FALSE)
    elseif(argument_lower STREQUAL "/fo" OR argument_lower STREQUAL "-fo")
        set(expect_object_file TRUE)
    elseif(argument_lower MATCHES "^[-/]fo.+$")
        string(SUBSTRING "${argument}" 3 -1 object_file)
    endif()
endforeach()
if(NOT has_command OR NOT object_file OR NOT dependency_file)
    message(FATAL_ERROR "MSVC include projection requires a compiler, /Fo and /sourceDependencies")
endif()

string(APPEND compiler_code
    " RESULT_VARIABLE compiler_result OUTPUT_VARIABLE compiler_stdout ERROR_VARIABLE compiler_stderr ENCODING ANSI)")
cmake_language(EVAL CODE "${compiler_code}")
if(NOT compiler_result STREQUAL "0")
    message("${compiler_stdout}${compiler_stderr}")
    message(FATAL_ERROR "Compiler failed with exit ${compiler_result}")
endif()

file(READ "${dependency_file}" dependency_json)
string(JSON include_count LENGTH "${dependency_json}" Data Includes)
set(dependency_lines)
if(include_count GREATER 0)
    math(EXPR last_include "${include_count} - 1")
    foreach(index RANGE 0 ${last_include})
        string(JSON header GET "${dependency_json}" Data Includes ${index})
        string(APPEND dependency_lines "Note: including file: ${header}\n")
    endforeach()
endif()
# A per-object temporary avoids Windows command-line limits. Explicit UTF8 on
# forwarding prevents CMake's AUTO decoder from corrupting Unicode paths again.
set(output_file "${object_file}.compiler-output.utf8.txt")
file(WRITE "${output_file}" "${compiler_stdout}${compiler_stderr}\n${dependency_lines}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E cat "${output_file}"
    RESULT_VARIABLE cat_result ENCODING UTF8)
file(REMOVE "${output_file}")
if(NOT cat_result STREQUAL "0")
    message(FATAL_ERROR "Unable to forward compiler output (${cat_result})")
endif()
