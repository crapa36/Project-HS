# Keep BC7's block work unchanged while amortizing constant-buffer maps and dispatches.
function(hs_patch_directxtex_bc7 source)
    set(path "${source}/DirectXTex/BCDirectCompute.cpp")
    file(READ "${path}" text)
    set(before "constexpr UINT MAX_BLOCK_BATCH = 64u;")
    set(after "const UINT MAX_BLOCK_BATCH = isbc7 ? 1024u : 64u;")
    string(FIND "${text}" "${before}" position)
    if(NOT position EQUAL -1)
        string(REPLACE "${before}" "${after}" text "${text}")
        file(WRITE "${path}" "${text}")
    else()
        string(FIND "${text}" "${after}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Unexpected pinned DirectXTex BC7 batch source: ${path}")
        endif()
    endif()
endfunction()
