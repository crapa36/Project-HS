# The pinned FidelityFX_SC GCC writer concatenates unescaped absolute paths.
# Its includes all come from the authenticated SDK root. Split at that exact
# root, rather than whitespace inside a filename, and write a valid depfile.
foreach(required IN ITEMS HS_DEPFILE HS_DEPFILE_OUTPUT HS_DEPFILE_SOURCE_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required} for native shader dependencies")
    endif()
endforeach()
file(READ "${HS_DEPFILE}" raw)
set(target_prefix "${HS_DEPFILE_OUTPUT}: ")
string(FIND "${raw}" "${target_prefix}" target_position)
if(NOT target_position EQUAL 0)
    message(FATAL_ERROR "Unexpected native shader depfile target: ${HS_DEPFILE}")
endif()
string(LENGTH "${target_prefix}" target_length)
string(SUBSTRING "${raw}" ${target_length} -1 includes)
string(REGEX REPLACE "[\r\n]+$" "" includes "${includes}")
if(includes MATCHES "[\r\n;]" OR includes STREQUAL "")
    message(FATAL_ERROR "Invalid native shader dependency records: ${HS_DEPFILE}")
endif()
set(source_prefix "${HS_DEPFILE_SOURCE_ROOT}/")
string(FIND "${includes}" "${source_prefix}" first_include)
if(NOT first_include EQUAL 0)
    message(FATAL_ERROR "Native shader include is outside the authenticated SDK")
endif()
string(REPLACE " ${source_prefix}" ";${source_prefix}" include_paths "${includes}")
function(escape_dependency value result)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "$" "$$" escaped "${escaped}")
    string(REPLACE " " "\\ " escaped "${escaped}")
    string(REPLACE "#" "\\#" escaped "${escaped}")
    string(REPLACE ":" "\\:" escaped "${escaped}")
    set(${result} "${escaped}" PARENT_SCOPE)
endfunction()
escape_dependency("${HS_DEPFILE_OUTPUT}" normalized)
string(APPEND normalized ":")
foreach(include IN LISTS include_paths)
    string(FIND "${include}" "${source_prefix}" include_position)
    if(NOT include_position EQUAL 0 OR NOT EXISTS "${include}")
        message(FATAL_ERROR "Missing or invalid native shader dependency: ${include}")
    endif()
    escape_dependency("${include}" escaped)
    string(APPEND normalized " ${escaped}")
endforeach()
string(APPEND normalized "\n")
file(WRITE "${HS_DEPFILE}" "${normalized}")
