# Optional native renderer SDKs are isolated from the low-level module graph.
function(hs_configure_render_sdks)
    option(HS_WITH_XESS "Build pinned XeSS super resolution" OFF)
    option(HS_WITH_XESS_FG "Build pinned XeSS frame generation" OFF)
    option(HS_WITH_XELL "Build pinned Intel XeLL latency control" OFF)
    option(HS_WITH_STREAMLINE "Build pinned NVIDIA Streamline adapters" OFF)
    option(HS_WITH_FSR "Build pinned AMD FSR adapters" OFF)
    option(HS_WITH_DIRECTSR "Build isolated pinned DirectSR preview adapter for local development" OFF)
    if(HS_WITH_XESS_FG AND NOT HS_WITH_XELL)
        message(FATAL_ERROR "XeSS frame generation requires HS_WITH_XELL.")
    endif()
    target_sources(hs_renderer_d3d12_common PRIVATE
        Source/RendererD3D12/Private/renderer_xess_fg.cpp
        Source/RendererD3D12/Private/renderer_xell.cpp
        Source/RendererD3D12/Private/renderer_streamline.cpp
        Source/RendererD3D12/Private/renderer_fsr.cpp
        Source/RendererD3D12/Private/renderer_directsr.cpp
        Source/RendererD3D12/Private/renderer_sdk_presentation.cpp
        Source/RendererD3D12/Private/presentation-guides.cpp)
    set(sdk_names directstorage directsr xess streamline fsr)
    foreach(sdk IN LISTS sdk_names)
        set(${sdk}_root "")
        string(TOUPPER "${sdk}" feature)
        if(NOT HS_WITH_${feature} AND NOT (sdk STREQUAL "xess" AND (HS_WITH_XESS_FG OR HS_WITH_XELL)))
            continue()
        endif()
        find_program(HS_SDK_POWERSHELL NAMES pwsh powershell REQUIRED)
        execute_process(COMMAND "${HS_SDK_POWERSHELL}" -NoProfile -ExecutionPolicy Bypass
            -File "${CMAKE_CURRENT_SOURCE_DIR}/tools/bootstrap_render_sdks.ps1"
            -Sdk "${sdk}" -Offline -PrintPath
            RESULT_VARIABLE result OUTPUT_VARIABLE verified_root ERROR_VARIABLE failure
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Pinned ${sdk} SDK verification failed. Run tools/bootstrap_render_sdks.ps1 -Sdk ${sdk}.\n${failure}")
        endif()
        file(TO_CMAKE_PATH "${verified_root}" ${sdk}_root)
    endforeach()

    set(src Source/RendererD3D12/Private)
    foreach(feature IN ITEMS XESS XESS_FG XELL)
        if(HS_WITH_${feature})
            string(TOLOWER "${feature}" adapter)
            set_property(SOURCE ${src}/renderer_${adapter}.cpp APPEND PROPERTY COMPILE_DEFINITIONS HS_WITH_${feature}=1)
            set_property(SOURCE ${src}/renderer_${adapter}.cpp APPEND PROPERTY INCLUDE_DIRECTORIES "${xess_root}/inc")
        endif()
    endforeach()
    if(HS_WITH_DIRECTSR)
        set_property(SOURCE ${src}/renderer_directsr.cpp APPEND PROPERTY COMPILE_DEFINITIONS HS_WITH_DIRECTSR=1)
        set_property(SOURCE ${src}/renderer_directsr.cpp APPEND PROPERTY INCLUDE_DIRECTORIES "${directsr_root}/build/native/include")
    endif()
    if(HS_WITH_STREAMLINE)
        set_property(SOURCE ${src}/renderer_streamline.cpp ${src}/renderer_reconstruction.cpp
            APPEND PROPERTY COMPILE_DEFINITIONS HS_WITH_STREAMLINE=1)
        set_property(SOURCE ${src}/renderer_streamline.cpp APPEND PROPERTY INCLUDE_DIRECTORIES "${streamline_root}/include")
    endif()
    if(HS_WITH_FSR)
        set_property(SOURCE ${src}/renderer_fsr.cpp ${src}/renderer_resources.cpp
            APPEND PROPERTY COMPILE_DEFINITIONS HS_WITH_FSR=1)
        foreach(component IN ITEMS api upscalers framegeneration)
            set_property(SOURCE ${src}/renderer_fsr.cpp APPEND PROPERTY INCLUDE_DIRECTORIES
                "${fsr_root}/Kits/FidelityFX/${component}/include")
        endforeach()
    endif()
    if(HS_WITH_STREAMLINE OR HS_WITH_FSR)
        target_link_libraries(hs_renderer_d3d12_common PRIVATE wintrust crypt32)
    endif()
    set_property(SOURCE ${src}/renderer.cpp ${src}/renderer_asset_io.cpp APPEND PROPERTY
        COMPILE_DEFINITIONS HS_WITH_DIRECTSTORAGE=$<BOOL:${HS_WITH_DIRECTSTORAGE}>)
    if(HS_WITH_DIRECTSTORAGE)
        target_link_libraries(hs_renderer_d3d12_common PRIVATE "${directstorage_root}/native/lib/x64/dstorage.lib")
        set_property(SOURCE ${src}/renderer_asset_io.cpp APPEND PROPERTY INCLUDE_DIRECTORIES "${directstorage_root}/native/include")
    endif()

    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/RenderSDKs.lock.json" sdk_lock)
    set(native_outputs)
    set(retired_directories "")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/RenderSDKs.lock.json" "${CMAKE_CURRENT_SOURCE_DIR}/tools/bootstrap_render_sdks.ps1")
    foreach(sdk IN LISTS sdk_names)
        set(sdk_root "${${sdk}_root}")
        foreach(kind IN ITEMS runtime notices)
            string(JSON component_count LENGTH "${sdk_lock}" sdks ${sdk} ${kind})
            if(component_count LESS 1)
                continue()
            endif()
            if(kind STREQUAL "notices" AND sdk STREQUAL "directstorage")
                set(destination "Licenses/DirectStorage-1.3.0")
            elseif(kind STREQUAL "notices")
                set(destination "Licenses/${sdk}")
            elseif(sdk STREQUAL "directsr")
                set(destination "DirectSR")
            elseif(sdk STREQUAL "xess" OR sdk STREQUAL "directstorage")
                set(destination ".")
            else()
                set(destination "${sdk}")
            endif()
            math(EXPR component_last "${component_count} - 1")
            set(directory "${HS_RUNTIME_DIRECTORY}/${destination}")
            if(IS_SYMLINK "${HS_RUNTIME_DIRECTORY}" OR IS_SYMLINK "${directory}" OR
               (kind STREQUAL "notices" AND IS_SYMLINK "${HS_RUNTIME_DIRECTORY}/Licenses"))
                message(FATAL_ERROR "SDK deployment requires a build-owned directory: ${directory}")
            endif()
            foreach(index RANGE 0 ${component_last})
                string(JSON relative GET "${sdk_lock}" sdks ${sdk} ${kind} ${index})
                get_filename_component(filename "${relative}" NAME)
                set(output "${directory}/${filename}")
                set(selected "${sdk_root}")
                if(selected AND sdk STREQUAL "xess" AND kind STREQUAL "runtime")
                    # Intel names each component DLL lib<feature>.dll.
                    get_filename_component(stem "${filename}" NAME_WE)
                    string(SUBSTRING "${stem}" 3 -1 feature)
                    string(TOUPPER "${feature}" feature)
                    set(selected "${HS_WITH_${feature}}")
                endif()
                if(NOT selected)
                    file(REMOVE "${output}")
                    continue()
                endif()
                hs_copy_runtime_asset("${sdk_root}/${relative}" "${output}")
                # The preview license does not establish redistribution rights.
                # Local build deployment is supported; exclude it from installs.
                if(NOT sdk STREQUAL "directsr")
                    install(FILES "${sdk_root}/${relative}" DESTINATION "${destination}" COMPONENT Runtime)
                endif()
                if(kind STREQUAL "runtime")
                    list(APPEND native_outputs "${output}")
                endif()
            endforeach()
            if(NOT sdk_root AND NOT destination STREQUAL ".")
                list(APPEND retired_directories "${directory}")
            endif()
        endforeach()
    endforeach()
    # Retire only empty generated directories. Keep neighboring licenses or user files.
    foreach(directory IN ITEMS ${retired_directories} "${HS_RUNTIME_DIRECTORY}/Licenses")
        if(IS_DIRECTORY "${directory}" AND NOT IS_SYMLINK "${directory}")
            file(GLOB contents "${directory}/*")
            if(NOT contents)
                file(REMOVE_RECURSE "${directory}")
            endif()
        endif()
    endforeach()
    set(HS_RUNTIME_ASSET_OUTPUTS "${HS_RUNTIME_ASSET_OUTPUTS}" PARENT_SCOPE)
    set(HS_RENDER_SDK_NATIVE_OUTPUTS "${native_outputs}" PARENT_SCOPE)
endfunction()
