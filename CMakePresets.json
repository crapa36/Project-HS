{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HS_BUILD_TESTS": "ON",
        "HS_BUILD_RUNTIME": "ON",
        "HS_BUILD_CONTENT_TOOLS": "ON",
        "HS_ENABLE_VALIDATION": "OFF",
        "HS_ENABLE_GPU_VALIDATION": "OFF"
      }
    },
    {
      "name": "msvc-core",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HS_BUILD_RUNTIME": "OFF",
        "HS_BUILD_CONTENT_TOOLS": "OFF"
      }
    },
    {
      "name": "msvc-asan-core",
      "inherits": "msvc-core",
      "binaryDir": "${sourceDir}/Build/tooling/msvc-asan-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Ob1 /DNDEBUG /Zi /fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/debug /INCREMENTAL:NO"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HS_ENABLE_VALIDATION": "ON"
      }
    },
    {
      "name": "msvc-validation",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HS_ENABLE_VALIDATION": "ON"
      }
    },
    {
      "name": "msvc-gpu-validation",
      "inherits": "msvc-validation",
      "cacheVariables": {
        "HS_ENABLE_GPU_VALIDATION": "ON"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HS_BUILD_TESTS": "OFF",
        "HS_ENABLE_VALIDATION": "OFF"
      }
    },
    {
      "name": "linux-core",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HS_BUILD_TESTS": "ON",
        "HS_BUILD_RUNTIME": "OFF",
        "HS_BUILD_CONTENT_TOOLS": "OFF"
      }
    },
    {
      "name": "msvc-portable-tests",
      "inherits": "msvc-core",
      "cacheVariables": {
        "HS_BUILD_RENDER_DATA_TESTS": "ON",
        "HS_BUILD_ASSET_PIPELINE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-core",
      "configurePreset": "msvc-core",
      "targets": [
        "hs_tests",
        "hs_gameplay_internal_tests",
        "hs_navigation_tests",
        "hs_simulation_tests",
        "hs_graphics_settings_tests",
        "hs_sha256_tests",
        "hs_simulation_rules_serialization_tests",
        "hs_task_system_failure_tests",
        "hs_hzb_region_tests",
        "hs_render_scene_extractor_tests",
        "hs_ui_command_admission_tests",
        "hs_vfx_session_state_tests",
        "hs_runtime_diagnostics_tests",
        "hs_project_hs_arguments_tests"
      ]
    },
    {
      "name": "msvc-asan-core",
      "configurePreset": "msvc-asan-core",
      "targets": [
        "hs_simulation_tests"
      ]
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-validation",
      "configurePreset": "msvc-validation"
    },
    {
      "name": "msvc-gpu-validation",
      "configurePreset": "msvc-gpu-validation"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release"
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core"
    },
    {
      "name": "msvc-portable-tests",
      "configurePreset": "msvc-portable-tests",
      "targets": [
        "all",
        "hs_audio_content_recipe_identity"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "msvc-core",
      "configurePreset": "msvc-core",
      "filter": {
        "include": {
          "name": "^(build\\.msvc-header-dependencies$|foundation\\.|rendering\\.(hzb-region-cpu|scene-delta)$|runtime\\.(ui-command-admission|diagnostics-bounds|arguments|vfx-session-state)$|architecture\\.layers$|simulation\\.(internal-invariants|navigation|determinism-core|canonical-rules)$)"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-asan-core",
      "configurePreset": "msvc-asan-core",
      "filter": {
        "include": {
          "name": "^simulation\\.determinism-core$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-validation",
      "configurePreset": "msvc-validation",
      "execution": {
        "jobs": 4
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-gpu-validation",
      "configurePreset": "msvc-gpu-validation",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-portable-tests",
      "configurePreset": "msvc-portable-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "verify-core",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-core"
        },
        {
          "type": "build",
          "name": "msvc-core"
        },
        {
          "type": "test",
          "name": "msvc-core"
        }
      ]
    },
    {
      "name": "verify",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-validation"
        },
        {
          "type": "build",
          "name": "msvc-validation"
        },
        {
          "type": "test",
          "name": "msvc-validation"
        }
      ]
    },
    {
      "name": "verify-core-linux",
      "steps": [
        {
          "type": "configure",
          "name": "linux-core"
        },
        {
          "type": "build",
          "name": "linux-core"
        },
        {
          "type": "test",
          "name": "linux-core"
        }
      ]
    },
    {
      "name": "verify-portable",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-portable-tests"
        },
        {
          "type": "build",
          "name": "msvc-portable-tests"
        },
        {
          "type": "test",
          "name": "msvc-portable-tests"
        }
      ]
    }
  ]
}
