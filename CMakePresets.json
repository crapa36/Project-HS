{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "environment": {
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HS_BUILD_TESTS": "OFF",
        "HS_BUILD_RUNTIME": "ON",
        "HS_BUILD_CONTENT_TOOLS": "ON"
      }
    },
    {
      "name": "msvc-core",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HS_BUILD_TESTS": "ON",
        "HS_BUILD_RUNTIME": "OFF",
        "HS_BUILD_CONTENT_TOOLS": "OFF"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-core",
      "configurePreset": "msvc-core",
      "targets": [
        "test_prep/all"
      ]
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "targets": [
        "ProjectHS"
      ]
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "targets": [
        "ProjectHS"
      ]
    },
    {
      "name": "verify",
      "configurePreset": "msvc-debug",
      "targets": [
        "test_prep/all"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "msvc-core",
      "configurePreset": "msvc-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "verify-core",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-core"
        },
        {
          "type": "build",
          "name": "msvc-core"
        },
        {
          "type": "test",
          "name": "msvc-core"
        }
      ]
    },
    {
      "name": "verify",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-debug"
        },
        {
          "type": "build",
          "name": "verify"
        },
        {
          "type": "test",
          "name": "msvc-debug"
        }
      ]
    }
  ]
}
