{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HS_ENABLE_VALIDATION": "ON"
      }
    },
    {
      "name": "msvc-validation",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HS_ENABLE_VALIDATION": "ON"
      }
    },
    {
      "name": "msvc-gpu-validation",
      "inherits": "msvc-validation",
      "cacheVariables": {
        "HS_ENABLE_GPU_VALIDATION": "ON"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HS_BUILD_TESTS": "OFF",
        "HS_ENABLE_VALIDATION": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-validation",
      "configurePreset": "msvc-validation"
    },
    {
      "name": "msvc-gpu-validation",
      "configurePreset": "msvc-gpu-validation"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-validation",
      "configurePreset": "msvc-validation",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-gpu-validation",
      "configurePreset": "msvc-gpu-validation",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "verify",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-validation"
        },
        {
          "type": "build",
          "name": "msvc-validation"
        },
        {
          "type": "test",
          "name": "msvc-validation"
        }
      ]
    }
  ]
}
