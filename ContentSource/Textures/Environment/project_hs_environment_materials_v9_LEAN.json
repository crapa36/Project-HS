{
  "schema_version": 9,
  "target": {
    "renderer": "D3D12",
    "texture_size_px": 2048,
    "normal": {
      "space": "tangent",
      "convention": "OpenGL_positive_Y",
      "shader_invert_green": false
    }
  },
  "samplers": {
    "environment_wrap": {
      "filter": "D3D12_FILTER_ANISOTROPIC",
      "address": "WRAP",
      "max_anisotropy": 16
    },
    "foliage_atlas": {
      "filter": "D3D12_FILTER_ANISOTROPIC",
      "address": "CLAMP",
      "max_anisotropy": 16,
      "max_lod": 5.0
    }
  },
  "terrain": {
    "mapping": "world_xz",
    "sampler": "environment_wrap",
    "layers": [
      {
        "id": "terrain_ground_dirt",
        "slice": 0,
        "weight_input": "dirt_weight",
        "meters_per_tile": 2.0,
        "height_scale_m": 0.025,
        "textures": {
          "base_color": "textures/terrain_ground_dirt_basecolor.png",
          "normal": "textures/terrain_ground_dirt_normal.png",
          "detail_normal": "textures/terrain_ground_dirt_detail_normal.png",
          "height": "textures/terrain_ground_dirt_height.png",
          "surface_ra": "textures/terrain_ground_dirt_surface_ra.png"
        }
      },
      {
        "id": "terrain_ground_grass_soil",
        "slice": 1,
        "weight_input": "grass_weight",
        "meters_per_tile": 2.0,
        "height_scale_m": 0.025,
        "textures": {
          "base_color": "textures/terrain_ground_grass_soil_basecolor.png",
          "normal": "textures/terrain_ground_grass_soil_normal.png",
          "detail_normal": "textures/terrain_ground_grass_soil_detail_normal.png",
          "height": "textures/terrain_ground_grass_soil_height.png",
          "surface_ra": "textures/terrain_ground_grass_soil_surface_ra.png"
        }
      },
      {
        "id": "terrain_ground_dry_soil",
        "slice": 2,
        "weight_input": "dryness_weight",
        "meters_per_tile": 2.0,
        "height_scale_m": 0.035,
        "textures": {
          "base_color": "textures/terrain_ground_dry_soil_basecolor.png",
          "normal": "textures/terrain_ground_dry_soil_normal.png",
          "detail_normal": "textures/terrain_ground_dry_soil_detail_normal.png",
          "height": "textures/terrain_ground_dry_soil_height.png",
          "surface_ra": "textures/terrain_ground_dry_soil_surface_ra.png"
        }
      },
      {
        "id": "terrain_ground_gravel",
        "slice": 3,
        "weight_input": "rockiness_weight",
        "meters_per_tile": 1.5,
        "height_scale_m": 0.05,
        "textures": {
          "base_color": "textures/terrain_ground_gravel_basecolor.png",
          "normal": "textures/terrain_ground_gravel_normal.png",
          "detail_normal": "textures/terrain_ground_gravel_detail_normal.png",
          "height": "textures/terrain_ground_gravel_height.png",
          "surface_ra": "textures/terrain_ground_gravel_surface_ra.png"
        }
      }
    ],
    "layer_selection": {
      "max_active": 2,
      "rule": "Clamp procedural weights to >=0, take largest two, renormalize to sum 1; if total<=1e-5 use terrain_ground_dirt=1.",
      "single_layer_threshold": 0.1
    },
    "height_blend": {
      "height_influence": 0.35,
      "formula": "t1=saturate(w1+(h1-h0)*height_influence); t0=1-t1. Each layer uses its own POM-displaced UV and height before this blend."
    },
    "pom": {
      "algorithm": "parallax_occlusion_mapping",
      "height_semantics": "0=lowest,1=highest",
      "height_channel": "r",
      "min_steps": 8,
      "max_steps": 24,
      "binary_refinement_steps": 3,
      "self_shadow": false,
      "full_until_m": 35.0,
      "fade_end_m": 55.0,
      "adaptive_steps": "lerp(min_steps,max_steps,1-saturate(abs(view_ts.z)))",
      "height_scale_uv": "layer.height_scale_m/layer.meters_per_tile",
      "view_vector": "view_ws=normalize(camera_world_position-surface_world_position); view_ts=mul(transpose(TBN),view_ws)",
      "trace": "layer_depth+=1/steps; uv-=(view_ts.xy/max(abs(view_ts.z),0.05))*height_scale_uv/steps until layer_depth>=height(uv); binary refine between last two samples.",
      "distance_fade": "height_scale_uv*=1-smoothstep(full_until_m,fade_end_m,camera_distance)",
      "sampling": "Capture ddx/ddy after the stable region UV transform and before ray traversal; use SampleGrad for height and final material samples."
    },
    "anti_tiling": {
      "near_pom": "One stable terrain-region transform: rotate 0/90/180/270 degrees plus tile-periodic UV offset from terrain_region_seed. Apply identically to BaseColor/SurfaceRA/Normal/DetailNormal/Height and transform tangent normal XY consistently.",
      "far_after_pom_zero": {
        "transition_m": [
          55.0,
          60.0
        ],
        "cell_size_m": 4.0,
        "samples": 3,
        "algorithm": "p=world_xz/cell_size_m; i=floor(p); f=frac(p). If f.x+f.y<1 use lattice vertices (i, i+(1,0), i+(0,1)) with weights (1-f.x-f.y,f.x,f.y); else use (i+(1,1), i+(0,1), i+(1,0)) with weights (f.x+f.y-1,1-f.x,1-f.y). For each lattice vertex hash(vertex,terrain_region_seed) to choose rotation 0/90/180/270 and an offset in [0,1)^2; apply that transform to the layer base UV, sample BaseColor/SurfaceRA/Normal/DetailNormal, and barycentrically blend. Apply the inverse 2D UV rotation to sampled tangent-normal XY before blending/normalization.",
        "branch_selection": "Between 55-60m use stable world-locked hash/blue-noise to choose single-sample or 3-sample branch; never evaluate both; never animate per frame."
      }
    },
    "normal_composition": "RNM",
    "variation": {
      "macro": {
        "world_scale_m": 18.0,
        "basecolor_strength": 0.08,
        "roughness_strength": 0.04
      },
      "meso": {
        "world_scale_m": 3.0,
        "basecolor_strength": 0.04
      },
      "noise": "Use deterministic 2D value noise in world XZ. For each scale, p=world_xz/world_scale_m; hash the four integer cell corners with terrain_region_seed plus a distinct macro/meso salt to values [0,1]; interpolate with quintic u=f^3*(f*(f*6-15)+10). Remap noise to [-1,1] before multiplying the declared strengths."
    },
    "detail_normal_fade_m": [
      35.0,
      55.0
    ],
    "pipeline_order": [
      "sample procedural weights and terrain_region_seed",
      "select top two layers",
      "choose near-POM or far-stochastic path by distance",
      "near: run POM independently for each active layer",
      "sample each layer material maps at its final UV",
      "height-blend active layers",
      "RNM-compose main/detail normals",
      "apply macro/meso variation",
      "shade with environment PBR"
    ],
    "uv_basis": {
      "uv": "world_position.xz / layer.meters_per_tile",
      "T": [
        1,
        0,
        0
      ],
      "B": [
        0,
        0,
        1
      ],
      "N": [
        0,
        1,
        0
      ],
      "terrain_region_seed": "Stable uint supplied by procedural map generation for each continuous terrain region."
    }
  },
  "opaque_mesh": {
    "sampler": "environment_wrap",
    "normal_composition": "RNM",
    "materials": [
      {
        "id": "mesh_rock",
        "mapping": {
          "mode": "triplanar_world",
          "meters_per_tile": 1.2,
          "blend_sharpness": 4.0,
          "rule": "weights=pow(abs(geometric_world_normal),blend_sharpness); weights/=sum(weights). Sample X/Y/Z planar projections at world scale meters_per_tile.",
          "normal_rule": "Decode tangent normals for each planar projection, reorient each projection normal into world space for its projection axis/sign, then normalize the weighted sum. Do not blend encoded normal RGB."
        },
        "textures": {
          "base_color": "textures/mesh_rock_basecolor.png",
          "normal": "textures/mesh_rock_normal.png",
          "detail_normal": "textures/mesh_rock_detail_normal.png",
          "surface_ra": "textures/mesh_rock_surface_ra.png"
        }
      },
      {
        "id": "mesh_bark",
        "mapping": {
          "mode": "cylindrical_branch_aligned_uv0",
          "tile_m": 1.0,
          "u_axis": "circumference",
          "v_axis": "growth_direction",
          "u_tiles": "max(1,round(circumference_m/tile_m))",
          "v_scale": "1 UV tile per tile_m",
          "duplicate_seam_vertices": true,
          "major_branches_use_separate_branch_aligned_islands": true,
          "triplanar_only_for_roots_or_severe_junction_distortion": true,
          "seam_requirement": "No stable color/roughness/normal line may be visible at integer-U seam under rotating directional light."
        },
        "textures": {
          "base_color": "textures/mesh_bark_basecolor.png",
          "normal": "textures/mesh_bark_normal.png",
          "detail_normal": "textures/mesh_bark_detail_normal.png",
          "surface_ra": "textures/mesh_bark_surface_ra.png"
        }
      }
    ]
  },
  "foliage": {
    "shader": "masked_two_sided_foliage",
    "sampler": "foliage_atlas",
    "alpha_cutoff": 0.5,
    "opacity_source": "base_color_alpha",
    "backface_normal": "Use SV_IsFrontFace; on backfaces flip geometric/interpolated N, keep T, rebuild B=normalize(cross(N,T))*tangent_w before tangent-normal transform.",
    "normal_composition": "RNM",
    "lod_fade": "stable object/world-space hash or blue-noise; never animate frame-to-frame",
    "atlas": {
      "size_px": 2048,
      "gutter_px": 48,
      "runtime_max_lod": 5,
      "uv_from_rect": "uv_min=(x,y)/2048; uv_max=(x+w,y+h)/2048",
      "mip_generation": "Process each entry independently inside its rect, preserve alpha coverage at cutoff 0.5, edge-dilate RGB/normal/roughness into the 48px zero-alpha gutter, then composite the mip atlas. Do not downsample the packed atlas as one image.",
      "entry_format": [
        "atlas",
        "x_px",
        "y_px",
        "w_px",
        "h_px",
        "group"
      ]
    },
