  "texture_cook": {
    "formats": {
      "base_color": "BC7_UNORM_SRGB",
      "surface_ra": "BC5_UNORM; R=roughness,G=ambient_occlusion",
      "normal": "BC5_UNORM; decode xy=rg*2-1; z=sqrt(saturate(1-dot(xy,xy)))",
      "height": "BC4_UNORM",
      "foliage_roughness": "BC4_UNORM"
    },
    "source": {
      "normal_and_detail_normal": "RGB8 PNG, Linear/Non-Color",
      "height": "16-bit grayscale PNG, Linear/Non-Color"
    },
    "mip_levels": {
      "opaque": 12,
      "foliage": 6
    },
    "mips": {
      "base_color": "Filter in linear light and encode sRGB.",
      "height": "Linear filter.",
      "normal": "For each footprint decode vectors, average without initial renormalization, save vector length r, normalize average, encode.",
      "tileable": "Use WRAP border sampling at every mip.",
      "foliage": "Use per-entry atlas mip rule defined in foliage.atlas.mip_generation.",
      "specular_aa": "For mip>0, from averaged-normal length r: if r<0.9999, kappa=(3*r-r*r*r)/max(1-r*r,1e-5); roughness=saturate(sqrt(roughness*roughness+1/max(kappa,1e-5))). Apply to SurfaceRA.R or foliage roughness; AO stays linearly filtered."
    },
    "resources": {
      "terrain_arrays": {
        "slice_order": [
          "terrain_ground_dirt",
          "terrain_ground_grass_soil",
          "terrain_ground_dry_soil",
          "terrain_ground_gravel"
        ],
        "BaseColor": "Texture2DArray BC7_UNORM_SRGB",
        "SurfaceRA": "Texture2DArray BC5_UNORM",
        "Normal": "Texture2DArray BC5_UNORM",
        "DetailNormal": "Texture2DArray BC5_UNORM",
        "Height": "Texture2DArray BC4_UNORM"
      },
      "grass_arrays": {
        "array_size": 2,
        "BaseColorAlpha": "BC7_UNORM_SRGB",
        "Normal": "BC5_UNORM",
        "Roughness": "BC4_UNORM"
      },
      "leaf_arrays": {
        "array_size": 3,
        "BaseColorAlpha": "BC7_UNORM_SRGB",
        "Normal": "BC5_UNORM",
        "Roughness": "BC4_UNORM"
      }
    },
    "upload": "Create resources/SRVs with declared mip counts and upload every mip for every array slice."
  },
  "renderer_integration": {
    "gbuffer_material": {
      "format": "DXGI_FORMAT_R8G8B8A8_UNORM",
      "channels": {
        "r": "roughness",
        "g": "ambient_occlusion",
        "b": "reserved_0",
        "a": "environment_pbr_flag"
      }
    },
    "pbr_branch": {
      "trigger": "GBufferMaterial.a>0.5",
      "dielectric_f0": 0.04,
      "ndf": "GGX",
      "geometry": "Smith",
      "fresnel": "Schlick",
      "roughness_alpha": "max(roughness*roughness,0.002)",
      "F0": "0.04.xxx",
      "diffuse": "(1-F)*base_color/PI",
      "ao": "Apply only to indirect/ambient lighting.",
      "indirect_diffuse": "irradiance/sky diffuse",
      "indirect_specular": "prefiltered environment/sky specular + BRDF integration LUT",
      "legacy_non_environment": "unchanged",
      "material_class": "dielectric_environment_only; all materials in this pack have metallic=0"
    },
    "foliage_transmission": "For direct light only: back=saturate(dot(-N,L)); transmission=base_color*transmission_strength*back*back*light_color*light_intensity*shadow_visibility. Add after opaque direct BRDF. Alpha mask gates the pixel; no separate thickness texture is supplied.",
    "bindings": {
      "terrain": "5 Texture2DArray: BaseColor,SurfaceRA,Normal,DetailNormal,Height",
      "rock": "BaseColor,SurfaceRA,Normal,DetailNormal",
      "bark": "BaseColor,SurfaceRA,Normal,DetailNormal",
      "grass": "3 Texture2DArray: BaseColorAlpha,Normal,Roughness",
      "leaf": "3 Texture2DArray: BaseColorAlpha,Normal,Roughness"
    }
  },
  "asset_replacement": {
    "before_final_content_lock": {
      "mandatory": {
        "all_normal_textures": "Replace every texture referenced by role normal with Blender high-poly/physically-authored geometry bake or scan/photogrammetry ground truth.",
        "all_detail_normal_textures": "Replace every texture referenced by role detail_normal by the same ground-truth workflow.",
        "terrain_height_textures": "Replace all terrain height textures by Blender geometry bake or scan/photogrammetry ground truth."
      },
      "preserve_paths_and_atlas_alignment": true
    },
    "replacement_rules": {
      "normal_and_detail_normal": {
        "space": "tangent",
        "convention": "OpenGL_positive_Y",
        "color_space": "Linear/Non-Color",
        "size_px": 2048,
        "tile_if_material_tiles": true,
        "shader_invert_green": false
      },
      "height": {
        "format": "16-bit grayscale PNG",
        "color_space": "Linear/Non-Color",
        "size_px": 2048,
        "black_is_low": true,
        "white_is_high": true,
        "tile_seamlessly": true,
        "no_baked_lighting_or_AO": true
      },
      "surface_ra": "If roughness or AO changes, regenerate the matching SurfaceRA file at the same path with R=roughness,G=AO."
    },
    "status": {
      "base_color": "usable integration asset, not calibrated scan albedo; final AAA art review/replacement recommended",
      "surface_ra": "usable integration asset, not measured; final AAA art review/replacement recommended",
      "normal_detail_height": "provisional and mandatory to replace before final content lock"
    }
  }
}