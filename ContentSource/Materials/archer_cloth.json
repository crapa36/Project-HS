{
  "id": "archer_cloth",
  "version": 7,
  "domain": "surface",
  "shading_model": "metallic_roughness",
  "parameters": [
    {
      "id": "metallic",
      "type": "float",
      "default": 0
    },
    {
      "id": "roughness_scale",
      "type": "float",
      "default": 1
    },
    {
      "id": "anisotropy",
      "type": "float",
      "default": 0.35
    },
    {
      "id": "sheen_weight",
      "type": "float",
      "default": 0.25
    },
    {
      "id": "sheen_tint",
      "type": "float3",
      "default": [
        0.6,
        0.6,
        0.6
      ]
    },
    {
      "id": "sheen_roughness",
      "type": "float",
      "default": 0.5
    }
  ],
  "textures": [],
  "samplers": [],
  "nodes": [
    {
      "id": "base_color",
      "op": "context",
      "type": "float3",
      "name": "sampled_base_color"
    },
    {
      "id": "normal",
      "op": "context",
      "type": "float3",
      "name": "shading_normal"
    },
    {
      "id": "roughness_sample",
      "op": "context",
      "type": "float",
      "name": "sampled_roughness"
    },
    {
      "id": "alpha",
      "op": "context",
      "type": "float",
      "name": "sampled_alpha"
    },
    {
      "id": "ao",
      "op": "context",
      "type": "float",
      "name": "sampled_ao"
    },
    {
      "id": "metallic",
      "op": "parameter",
      "type": "float",
      "name": "metallic"
    },
    {
      "id": "roughness_scale",
      "op": "parameter",
      "type": "float",
      "name": "roughness_scale"
    },
    {
      "id": "roughness",
      "op": "multiply",
      "type": "float",
      "a": {
        "node": "roughness_sample",
        "type": "float"
      },
      "b": {
        "node": "roughness_scale",
        "type": "float"
      }
    },
    {
      "id": "alpha_cutoff_scale",
      "op": "constant",
      "type": "float",
      "value": 2.5
    },
    {
      "id": "opacity_scaled",
      "op": "multiply",
      "type": "float",
      "a": {
        "node": "alpha",
        "type": "float"
      },
      "b": {
        "node": "alpha_cutoff_scale",
        "type": "float"
      }
    },
    {
      "id": "opacity",
      "op": "saturate",
      "type": "float",
      "input": {
        "node": "opacity_scaled",
        "type": "float"
      }
    },
    {
      "id": "basic",
      "op": "metallic_roughness_closure",
      "type": "surface_closure",
      "base_color": {
        "node": "base_color",
        "type": "float3"
      },
      "normal": {
        "node": "normal",
        "type": "float3"
      },
      "roughness": {
        "node": "roughness",
        "type": "float"
      },
      "metallic": {
        "node": "metallic",
        "type": "float"
      },
      "ao": {
        "node": "ao",
        "type": "float"
      },
      "opacity": {
        "node": "opacity",
        "type": "float"
      }
    },
    {
      "id": "anisotropy",
      "op": "parameter",
      "type": "float",
      "name": "anisotropy"
    },
    {
      "id": "sheen_weight",
      "op": "parameter",
      "type": "float",
      "name": "sheen_weight"
    },
    {
      "id": "sheen_tint",
      "op": "parameter",
      "type": "float3",
      "name": "sheen_tint"
    },
    {
      "id": "sheen_roughness",
      "op": "parameter",
      "type": "float",
      "name": "sheen_roughness"
    },
    {
      "id": "tangent_frame",
      "op": "context",
      "type": "float4",
      "name": "tangent"
    },
    {
      "id": "tangent_0",
      "op": "extract",
      "type": "float",
      "input": {
        "node": "tangent_frame",
        "type": "float4"
      },
      "component": 0
    },
    {
      "id": "tangent_1",
      "op": "extract",
      "type": "float",
      "input": {
        "node": "tangent_frame",
        "type": "float4"
      },
      "component": 1
    },
    {
      "id": "tangent_2",
      "op": "extract",
      "type": "float",
      "input": {
        "node": "tangent_frame",
        "type": "float4"
      },
      "component": 2
    },
    {
      "id": "tangent",
      "op": "construct",
      "type": "float3",
      "components": [
        {
          "node": "tangent_0",
          "type": "float"
        },
        {
          "node": "tangent_1",
          "type": "float"
        },
        {
          "node": "tangent_2",
          "type": "float"
        }
      ]
    },
    {
      "id": "anisotropic",
      "op": "anisotropy_closure",
      "type": "surface_closure",
      "base": {
        "node": "basic",
        "type": "surface_closure"
      },
      "amount": {
        "node": "anisotropy",
        "type": "float"
      },
      "tangent": {
        "node": "tangent",
        "type": "float3"
      }
    },
    {
      "id": "surface",
      "op": "sheen_closure",
      "type": "surface_closure",
      "base": {
        "node": "anisotropic",
        "type": "surface_closure"
      },
      "weight": {
        "node": "sheen_weight",
        "type": "float"
      },
      "tint": {
        "node": "sheen_tint",
        "type": "float3"
      },
      "roughness": {
        "node": "sheen_roughness",
        "type": "float"
      }
    }
  ],
  "outputs": {
    "surface": "typed_closure",
    "closure": {
      "node": "surface",
      "type": "surface_closure"
    },
    "normal_space": "world"
  },
  "render_flags": {
    "two_sided": false,
    "alpha_mode": "mask"
  }
}
