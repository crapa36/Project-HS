{
  "id": "archer_equipment",
  "version": 7,
  "domain": "surface",
  "shading_model": "metallic_roughness",
  "parameters": [
    {
      "id": "metallic",
      "type": "float",
      "default": 0
    },
    {
      "id": "roughness_scale",
      "type": "float",
      "default": 1
    }
  ],
  "textures": [],
  "samplers": [],
  "nodes": [
    {
      "id": "base_color",
      "op": "context",
      "type": "float3",
      "name": "sampled_base_color"
    },
    {
      "id": "normal",
      "op": "context",
      "type": "float3",
      "name": "shading_normal"
    },
    {
      "id": "roughness_sample",
      "op": "context",
      "type": "float",
      "name": "sampled_roughness"
    },
    {
      "id": "alpha",
      "op": "context",
      "type": "float",
      "name": "sampled_alpha"
    },
    {
      "id": "ao",
      "op": "context",
      "type": "float",
      "name": "sampled_ao"
    },
    {
      "id": "metallic",
      "op": "parameter",
      "type": "float",
      "name": "metallic"
    },
    {
      "id": "roughness_scale",
      "op": "parameter",
      "type": "float",
      "name": "roughness_scale"
    },
    {
      "id": "roughness",
      "op": "multiply",
      "type": "float",
      "a": {
        "node": "roughness_sample",
        "type": "float"
      },
      "b": {
        "node": "roughness_scale",
        "type": "float"
      }
    },
    {
      "id": "alpha_cutoff_scale",
      "op": "constant",
      "type": "float",
      "value": 2.5
    },
    {
      "id": "opacity_scaled",
      "op": "multiply",
      "type": "float",
      "a": {
        "node": "alpha",
        "type": "float"
      },
      "b": {
        "node": "alpha_cutoff_scale",
        "type": "float"
      }
    },
    {
      "id": "opacity",
      "op": "saturate",
      "type": "float",
      "input": {
        "node": "opacity_scaled",
        "type": "float"
      }
    },
    {
      "id": "basic",
      "op": "metallic_roughness_closure",
      "type": "surface_closure",
      "base_color": {
        "node": "base_color",
        "type": "float3"
      },
      "normal": {
        "node": "normal",
        "type": "float3"
      },
      "roughness": {
        "node": "roughness",
        "type": "float"
      },
      "metallic": {
        "node": "metallic",
        "type": "float"
      },
      "ao": {
        "node": "ao",
        "type": "float"
      },
      "opacity": {
        "node": "opacity",
        "type": "float"
      }
    }
  ],
  "outputs": {
    "surface": "typed_closure",
    "closure": {
      "node": "basic",
      "type": "surface_closure"
    },
    "normal_space": "world"
  },
  "render_flags": {
    "two_sided": false,
    "alpha_mode": "mask"
  }
}
