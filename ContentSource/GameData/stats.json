{
  "$schema": "../../Schemas/game.schema.json",
  "schema_version": 1,
  "category": "stats",
  "entries": [
    {
      "id": "stats.archer",
      "maximum_points_per_stat": 10,
      "base_values": {
        "maximum_hp": 100,
        "current_hp": 100,
        "attack_power": 10,
        "basic_attack_rate_per_second": 1.5,
        "movement_speed_mps": 5,
        "magnet_radius_m": 3,
        "global_cooldown_reduction": 0
      },
      "allocations": [
        {
          "id": "stat.maximum_hp",
          "display_name": "최대 체력",
          "operation": "base_fraction_per_point",
          "amount_per_point": 0.08,
          "formula": "round(100 * (1 + 0.08 * points))",
          "immediate_current_hp_restore_per_point": 8,
          "applies_to": "maximum_hp"
        },
        {
          "id": "stat.movement_speed",
          "display_name": "이동속도",
          "operation": "base_fraction_per_point",
          "amount_per_point": 0.03,
          "formula": "5 * (1 + 0.03 * points)",
          "immediate_current_hp_restore_per_point": 0,
          "applies_to": "movement_speed"
        },
        {
          "id": "stat.attack_power",
          "display_name": "공격력",
          "operation": "base_fraction_per_point",
          "amount_per_point": 0.06,
          "formula": "10 * (1 + 0.06 * points)",
          "immediate_current_hp_restore_per_point": 0,
          "applies_to": "attack_power"
        },
        {
          "id": "stat.basic_attack_speed",
          "display_name": "공격속도",
          "operation": "base_fraction_per_point",
          "amount_per_point": 0.05,
          "formula": "1.5 * (1 + 0.05 * points)",
          "immediate_current_hp_restore_per_point": 0,
          "applies_to": "basic_attack_only"
        },
        {
          "id": "stat.cooldown_reduction",
          "display_name": "쿨타임 감소",
          "operation": "percentage_points_per_point",
          "amount_per_point": 0.03,
          "formula": "0.03 * points",
          "immediate_current_hp_restore_per_point": 0,
          "applies_to": "global_cooldown_reduction"
        },
        {
          "id": "stat.magnet_radius",
          "display_name": "자석 반경",
          "operation": "absolute_per_point",
          "amount_per_point": 0.4,
          "formula": "3 + 0.4 * points",
          "immediate_current_hp_restore_per_point": 0,
          "applies_to": "magnet_radius"
        }
      ],
      "combat": {
        "raw_damage_formula": "attack_power * coefficient * conditional_multipliers",
        "final_damage_rounding": "nearest_integer",
        "minimum_final_damage": 1,
        "cooldown_formula": "base_cooldown * (1 - global_reduction) * skill_multiplier",
        "minimum_cooldown_seconds": 0.25,
        "skill_cooldown_upgrade_multiplier": 0.75,
        "critical_hits": false,
        "armor": false,
        "hit_invulnerability": false,
        "player_hit_knockback": false,
        "maximum_basic_attacks_per_tick": 1
      },
      "statuses": [
        {
          "id": "status.slow",
          "logic_id": "independent_multiplicative_slow",
          "parameters": [],
          "rules": [
            "적용 출처별로 독립 지속시간을 가진다.",
            "이동 배율을 서로 곱한다.",
            "감소율 하한과 중첩 수 제한은 없다."
          ]
        },
        {
          "id": "status.bleed",
          "logic_id": "five_stack_attack_snapshot_dot",
          "parameters": [
            {"key": "maximum_stacks", "value": 5, "unit": "count"},
            {"key": "duration", "value": 4, "unit": "seconds"},
            {"key": "tick_interval", "value": 0.5, "unit": "seconds"},
            {"key": "attack_power_multiplier_per_tick", "value": 0.1, "unit": "multiplier"}
          ],
          "rules": [
            "각 중첩은 적용 당시 공격자의 공격력을 저장한다.",
            "5중첩 상태에서 새 출혈을 적용하면 가장 오래된 중첩을 교체한다."
          ]
        },
        {
          "id": "status.burn",
          "logic_id": "single_strongest_attack_snapshot_dot",
          "parameters": [
            {"key": "maximum_instances", "value": 1, "unit": "count"},
            {"key": "duration", "value": 4, "unit": "seconds"},
            {"key": "tick_interval", "value": 0.5, "unit": "seconds"},
            {"key": "attack_power_multiplier_per_tick", "value": 0.2, "unit": "multiplier"}
          ],
          "rules": [
            "새 화상의 tick 피해가 기존보다 강하면 새 화상으로 교체한다.",
            "새 화상이 같거나 약하면 기존 세기를 유지하고 남은 시간을 4초로 갱신한다."
          ]
        }
      ],
      "derived_effect_rules": [
        "지속 피해는 별도 투사체, 폭발, 유물 연쇄를 생성하지 않는다.",
        "파생 효과는 피해와 상태를 적용할 수 있지만 또 다른 파생 투사체나 파생 폭발을 만들 수 없다.",
        "각 효과는 원본/파생 플래그와 생성 원인을 보존한다."
      ],
      "rules": [
        "최대 체력 포인트의 현재 HP 회복은 최대 HP를 넘지 않는다.",
        "공격속도 포인트는 LMB 기본 공격에만 적용한다.",
        "모든 스탯이 10포인트이면 새 스탯 포인트는 소비 처리하고 스탯 화면을 열지 않는다."
      ]
    }
  ]
}
