{
  "$schema": "../../Schemas/game.schema.json",
  "schema_version": 1,
  "category": "upgrades",
  "groups": [
    {
      "skill_id": "skill.basic_attack",
      "entries": [
        {
          "ordinal": 1,
          "logic_id": "third_attack_delayed_basic_attack",
          "parameters": [
            {"key": "cadence_interval", "value": 3, "unit": "count"},
            {"key": "delay", "value": 0.08, "unit": "seconds"},
            {"key": "damage_multiplier", "value": 0.7, "unit": "multiplier"}
          ],
          "rule": "매 3번째 기본 공격 뒤 70% 위력의 기본 공격을 한 번 더 발사한다."
        },
        {
          "ordinal": 2,
          "logic_id": "additional_pierce",
          "parameters": [{"key": "additional_targets", "value": 1, "unit": "count"}],
          "rule": "기본 화살이 적 1명을 추가 관통한다."
        },
        {
          "ordinal": 3,
          "logic_id": "first_hit_split",
          "parameters": [
            {"key": "angles", "value": [-30, 30], "unit": "degrees"},
            {"key": "projectile_count", "value": 2, "unit": "count"},
            {"key": "damage_multiplier", "value": 0.5, "unit": "multiplier"}
          ],
          "rule": "기본 화살이 적중 후 절반의 데미지를 주는 공격 두개로 분열된다."
        },
        {
          "ordinal": 4,
          "logic_id": "fourth_direct_arrow_bleed",
          "parameters": [
            {"key": "direct_arrow_interval", "value": 3, "unit": "count"},
            {"key": "bleed_stacks", "value": 1, "unit": "count"}
          ],
          "rule": "매 3번째 기본 화살이 출혈을 부여한다."
        },
        {
          "ordinal": 5,
          "logic_id": "fourth_direct_arrow_burn",
          "parameters": [{"key": "direct_arrow_interval", "value": 4, "unit": "count"}],
          "rule": "매 4번째 기본 화살이 화상을 부여한다."
        },
        {
          "ordinal": 6,
          "logic_id": "first_hit_slow_and_reduce_longest_active_cooldown",
          "parameters": [
            {"key": "slow_fraction", "value": 0.2, "unit": "fraction"},
            {"key": "slow_duration", "value": 1, "unit": "seconds"},
            {"key": "cooldown_reduction", "value": 0.2, "unit": "seconds"}
          ],
          "rule": "기본 공격이 첫 적중 대상에게 20% 둔화를 1초 부여하고 남은 쿨타임이 가장 긴 액티브 스킬 하나를 0.2초 단축한다."
        },
        {
          "ordinal": 7,
          "logic_id": "missed_arrow_reacquire",
          "parameters": [
            {"key": "damage_multiplier", "value": 1, "unit": "multiplier"},
            {"key": "maximum_retargets", "value": 1, "unit": "count"}
          ],
          "rule": "적에게 적중하지 않은 화살이 최대 사거리 지점에서 가까운 적을 찾아 추적한다."
        },
        {
          "ordinal": 8,
          "logic_id": "post_active_three_arrow_replacement",
          "parameters": [
            {"key": "activation_window", "value": 3, "unit": "seconds"},
            {"key": "angles", "value": [-15, 0, 15], "unit": "degrees"},
            {"key": "projectile_count", "value": 3, "unit": "count"},
            {"key": "damage_multiplier_per_arrow", "value": 0.7, "unit": "multiplier"}
          ],
          "rule": "액티브 스킬 사용 후 3초 안에 발사하는 다음 기본 공격이 70% 데미지의 화살 3발로 변경된다."
        }
      ]
    },
    {
      "skill_id": "skill.piercing_shot",
      "entries": [
        {
          "ordinal": 1,
          "logic_id": "delayed_followup_arrow",
          "parameters": [
            {"key": "delay", "value": 0.08, "unit": "seconds"},
            {"key": "damage_multiplier", "value": 5, "unit": "multiplier"}
          ],
          "rule": "발사 직후 적을 추적하는 매우 강한 후속 화살을 추가 발사한다."
        },
        {
          "ordinal": 2,
          "logic_id": "range_end_split",
          "parameters": [
            {"key": "angles", "value": [-20, 20], "unit": "degrees"},
            {"key": "projectile_count", "value": 2, "unit": "count"},
            {"key": "damage_multiplier", "value": 0.9, "unit": "multiplier"}
          ],
          "rule": "최대 사거리에서 90% 화살 2발을 분기하며, 주변 적이 있으면 추적한다."
        },
        {
          "ordinal": 3,
          "logic_id": "apply_bleed",
          "parameters": [{"key": "bleed_stacks", "value": 2, "unit": "count"}],
          "rule": "적중 대상에게 출혈 2중첩을 부여한다."
        },
        {
          "ordinal": 4,
          "logic_id": "damaging_slow_trail",
          "parameters": [
            {"key": "width", "value": 1, "unit": "meters"},
            {"key": "duration", "value": 2, "unit": "seconds"},
            {"key": "tick_interval", "value": 0.5, "unit": "seconds"},
            {"key": "damage_multiplier_per_tick", "value": 0.4, "unit": "multiplier"},
            {"key": "slow_fraction", "value": 0.2, "unit": "fraction"},
            {"key": "slow_duration", "value": 1, "unit": "seconds"}
          ],
          "rule": "화살 경로에 2초 동안 0.5초마다 40% 피해를 주고 20% 둔화를 1초 부여하는 지대를 남긴다."
        },
        {
          "ordinal": 5,
          "logic_id": "per_three_pierces_perpendicular_arrows",
          "parameters": [
            {"key": "normal_enemy_pierce_interval", "value": 3, "unit": "count"},
            {"key": "projectile_count", "value": 2, "unit": "count"},
            {"key": "angle_from_direction", "value": 90, "unit": "degrees"},
            {"key": "damage_multiplier", "value": 2, "unit": "multiplier"}
          ],
          "rule": "일반 적 3명을 관통할 때마다 좌우 방향으로 추가로 적을 공격하는 화살이 생성된다."
        },
        {
          "ordinal": 6,
          "logic_id": "align_hit_normal_enemy",
          "parameters": [{"key": "move_distance", "value": 3.0, "unit": "meters"}],
          "rule": "적중한 일반 적을 공격 방향으로 밀어낸다."
        },
        {
          "ordinal": 7,
          "logic_id": "apply_and_transfer_burn_to_next_hit",
          "parameters": [{"key": "maximum_transfer_targets", "value": 3, "unit": "count"}],
          "rule": "첫 대상에게 화상을 부여하고 남은 화상을 이후 적중 대상 최대 3명에게 전달한다."
        },
        {
          "ordinal": 8,
          "logic_id": "cooldown_multiplier",
          "parameters": [{"key": "cooldown_multiplier", "value": 0.75, "unit": "multiplier"}],
          "rule": "쿨타임을 25% 줄인다."
        }
      ]
    },
    {
      "skill_id": "skill.multishot",
      "entries": [
        {
          "ordinal": 1,
          "logic_id": "delayed_second_fan",
          "parameters": [
            {"key": "delay", "value": 0.25, "unit": "seconds"},
            {"key": "fan_angle", "value": 50, "unit": "degrees"},
            {"key": "projectile_count", "value": 5, "unit": "count"},
            {"key": "damage_multiplier_per_arrow", "value": 1.5, "unit": "multiplier"}
          ],
          "rule": "0.25초 뒤 같은 50° 부채꼴에 150% 위력 화살 5발의 2차 부채를 발사한다."
        },
        {
          "ordinal": 2,
          "logic_id": "original_arrow_first_hit_split",
          "parameters": [
            {"key": "angles", "value": [-25, 25], "unit": "degrees"},
            {"key": "projectile_count_per_original", "value": 2, "unit": "count"},
            {"key": "damage_multiplier", "value": 0.35, "unit": "multiplier"}
          ],
          "rule": "각 원본 화살의 첫 적중에서 진행 방향 기준 ±25°로 약한 화살을 분기한다."
        },
        {
          "ordinal": 3,
          "logic_id": "additional_pierce_per_arrow",
          "parameters": [{"key": "additional_pierce", "value": 1, "unit": "count"}],
          "rule": "각 화살의 관통 수를 1 늘린다."
        },
        {
          "ordinal": 4,
          "logic_id": "rear_fan",
          "parameters": [
            {"key": "projectile_count", "value": 3, "unit": "count"},
            {"key": "damage_multiplier", "value": 1, "unit": "multiplier"}
          ],
          "rule": "시전 방향 반대쪽으로 기본 위력 화살 3발을 발사한다."
        },
        {
          "ordinal": 5,
          "logic_id": "first_cast_hit_bleed",
          "parameters": [{"key": "bleed_stacks", "value": 1, "unit": "count"}],
          "rule": "대상의 해당 시전 첫 적중에 출혈 1중첩을 부여한다."
        },
        {
          "ordinal": 6,
          "logic_id": "apply_burn_and_transfer_arrow",
          "parameters": [
            {"key": "damage_multiplier", "value": 0.7, "unit": "multiplier"},
            {"key": "maximum_transfers_per_cast", "value": 3, "unit": "count"}
          ],
          "rule": "적중 대상에게 화상을 부여하고 근처 비화상 적에게 70% 추적 화살과 화상을 전달한다. 시전당 최대 3회다."
        },
        {
          "ordinal": 7,
          "logic_id": "two_additional_outer_arrows",
          "parameters": [
            {"key": "additional_projectiles", "value": 2, "unit": "count"},
            {"key": "outer_angles", "value": [-31.25, 31.25], "unit": "degrees"}
          ],
          "rule": "부채꼴 바깥쪽에 기본 위력의 화살 2발을 추가해 한 번에 11발을 발사한다."
        },
        {
          "ordinal": 8,
          "logic_id": "missed_arrow_retarget",
          "parameters": [
            {"key": "damage_multiplier", "value": 0.55, "unit": "multiplier"},
            {"key": "maximum_retargets", "value": 1, "unit": "count"}
          ],
          "rule": "원본과 강화로 생성된 다중 사격 화살이 빗나가면 끝점 근처의 적에게 약한 위력으로 1회 재추적한다."
        }
      ]
    },
    {
      "skill_id": "skill.charged_shot",
      "entries": [
        {
          "ordinal": 1,
          "logic_id": "extended_full_charge_explosion",
          "parameters": [
            {"key": "maximum_charge_time", "value": 1.4, "unit": "seconds"},
            {"key": "maximum_damage_multiplier", "value": 14, "unit": "multiplier"},
            {"key": "full_charge_end_explosion_damage_multiplier", "value": 5, "unit": "multiplier"}
          ],
          "rule": "최대 충전 시간이 늘어나지만 완전 충전 피해와 끝점 폭발이 크게 강해진다."
        },
        {
          "ordinal": 2,
          "logic_id": "faster_charge",
          "parameters": [{"key": "charge_time_multiplier", "value": 0.65, "unit": "multiplier"}],
          "rule": "동일 충전율 도달 시간을 35% 줄인다."
        },
        {
          "ordinal": 3,
          "logic_id": "increase_minimum_charge_damage",
          "parameters": [{"key": "minimum_damage_multiplier", "value": 11.5, "unit": "multiplier"}],
          "rule": "충전하지 않고 바로 발사해도 매우 강한 피해를 주며 이후 충전 피해는 그대로 증가한다."
        },
        {
          "ordinal": 4,
          "logic_id": "additional_pierce",
          "parameters": [{"key": "additional_pierce", "value": 4, "unit": "count"}],
          "rule": "추가 관통 수가 4 늘어나 최대 14명의 적을 추가 관통한다."
        },
        {
          "ordinal": 5,
          "logic_id": "charge_bleed_full_charge_rupture",
          "parameters": [
            {"key": "bleed_stacks", "value": 3, "unit": "count"},
            {"key": "existing_bleed_stacks_for_rupture", "value": 5, "unit": "count"},
            {"key": "rupture_damage_multiplier", "value": 1.5, "unit": "multiplier"}
          ],
          "rule": "충전율과 관계없이 적중 시 출혈 3중첩을 부여한다. 완전 충전으로 이미 출혈 5중첩인 대상을 맞히면 150% 파열 피해를 추가한다."
        },
        {
          "ordinal": 6,
          "logic_id": "boss_or_fifth_pierce_split",
          "parameters": [
            {"key": "normal_enemy_pierce_count", "value": 3, "unit": "count"},
            {"key": "angles", "value": [-35, -25, -15, -5, 5, 15, 25, 35], "unit": "degrees"},
            {"key": "projectile_count", "value": 8, "unit": "count"},
            {"key": "damage_multiplier", "value": 3.5, "unit": "multiplier"}
          ],
          "rule": "보스를 처음 맞히거나 일반 적 3명을 관통하면 해당 지점에서 여덟 방향으로 강한 화살을 분기한다."
        },
        {
          "ordinal": 7,
          "logic_id": "first_hit_burn_explosion",
          "parameters": [
            {"key": "radius", "value": 3.5, "unit": "meters"},
            {"key": "damage_multiplier", "value": 2, "unit": "multiplier"}
          ],
          "rule": "첫 적중 대상에게 화상을 부여하고 그 주변을 넓게 폭발시킨다."
        },
        {
          "ordinal": 8,
          "logic_id": "full_charge_multi_kill_cooldown_refund",
          "parameters": [
            {"key": "minimum_normal_enemy_kills", "value": 3, "unit": "count"},
            {"key": "current_cooldown_refund_fraction", "value": 0.4, "unit": "fraction"}
          ],
          "rule": "완전 충전 한 발로 일반 적을 3명 이상 처치하면 현재 쿨타임의 40%를 반환한다."
        }
      ]
    },
    {
      "skill_id": "skill.explosive_arrow",
      "entries": [
        {
          "ordinal": 1,
          "logic_id": "delayed_reexplosion",
          "parameters": [
            {"key": "delay", "value": 0.3, "unit": "seconds"},
            {"key": "radius", "value": 4.5, "unit": "meters"},
            {"key": "damage_multiplier", "value": 3, "unit": "multiplier"}
          ],
          "rule": "주 폭발 직후 같은 위치에서 더 넓은 재폭발을 일으킨다."
        },
        {
          "ordinal": 2,
          "logic_id": "three_delayed_satellite_bombs",
          "parameters": [
            {"key": "bomb_count", "value": 3, "unit": "count"},
            {"key": "angular_spacing", "value": 120, "unit": "degrees"},
            {"key": "placement_radius", "value": 1.5, "unit": "meters"},
            {"key": "delay", "value": 0.15, "unit": "seconds"},
            {"key": "explosion_radius", "value": 4.5, "unit": "meters"},
            {"key": "damage_multiplier", "value": 1.5, "unit": "multiplier"}
          ],
          "rule": "주 폭발 주변에 소형 폭탄 3개를 놓고 잠시 뒤 각각 120% 피해를 준다."
        },
        {
          "ordinal": 3,
          "logic_id": "eight_direction_fragments",
          "parameters": [
            {"key": "direction_count", "value": 8, "unit": "count"},
            {"key": "damage_multiplier", "value": 1, "unit": "multiplier"}
          ],
          "rule": "주 폭발에서 넓은 판정의 70% 관통 파편을 8방향으로 발사한다."
        },
        {
          "ordinal": 4,
          "logic_id": "explosion_leaves_burning_area",
          "parameters": [
            {"key": "radius", "value": 3, "unit": "meters"},
            {"key": "duration", "value": 4, "unit": "seconds"},
            {"key": "tick_interval", "value": 0.5, "unit": "seconds"},
            {"key": "damage_multiplier_per_tick", "value": 0.35, "unit": "multiplier"}
          ],
          "rule": "폭발 위치에 반경 3m 불장판을 4초 남긴다. 0.5초마다 35% 피해와 화상을 적용한다."
        },
        {
          "ordinal": 5,
          "logic_id": "apply_bleed_and_blood_explosions",
          "parameters": [
            {"key": "radius", "value": 2, "unit": "meters"},
            {"key": "damage_multiplier", "value": 1.2, "unit": "multiplier"},
            {"key": "maximum_explosions_per_cast", "value": 8, "unit": "count"}
          ],
          "rule": "폭발에 맞은 적에게 출혈을 부여하고 각 대상 위치에 120% 혈폭을 일으킨다. 시전당 최대 8회다."
        },
        {
          "ordinal": 6,
          "logic_id": "pre_explosion_pull",
          "parameters": [
            {"key": "duration", "value": 0.25, "unit": "seconds"},
            {"key": "pull_radius", "value": 2.5, "unit": "meters"}
          ],
          "rule": "폭발 전 0.25초 동안 일반 적을 중심으로 2.5m 흡인한다."
        },
        {
          "ordinal": 7,
          "logic_id": "direct_hit_mark_other_active_explosion",
          "parameters": [
            {"key": "immediate_explosion_damage_multiplier", "value": 3, "unit": "multiplier"},
            {"key": "mark_explosion_damage_multiplier", "value": 4, "unit": "multiplier"}
          ],
          "rule": "직접 적중 시 즉시 추가 폭발을 일으키고 표식을 남긴다. 살아남은 대상은 다음 다른 원본 공격 적중 시 다시 폭발한다."
        },
        {
          "ordinal": 8,
          "logic_id": "cooldown_multiplier",
          "parameters": [{"key": "cooldown_multiplier", "value": 0.75, "unit": "multiplier"}],
          "rule": "쿨타임을 25% 줄인다."
        }
      ]
    },
    {
      "skill_id": "skill.ricochet_arrow",
      "entries": [
        {
          "ordinal": 1,
          "logic_id": "return_to_player_rehit",
          "parameters": [
            {"key": "damage_multiplier", "value": 1, "unit": "multiplier"},
            {"key": "maximum_rehit_targets", "value": 5, "unit": "count"}
          ],
          "rule": "마지막 지점에서 화살이 플레이어에게 귀환하며 돌아오는 동안 최대 5대상을 재타격한다."
        },
        {
          "ordinal": 2,
          "logic_id": "first_ricochet_branch_chain",
          "parameters": [
            {"key": "damage_multiplier", "value": 1, "unit": "multiplier"},
            {"key": "maximum_targets", "value": 3, "unit": "count"}
          ],
          "rule": "첫 도탄 지점에서 별도 3대상 분기 연쇄를 만든다."
        },
        {
          "ordinal": 3,
          "logic_id": "apply_bleed_and_extend_ricochets",
          "parameters": [
            {"key": "additional_ricochets_per_bleeding_hit", "value": 1, "unit": "count"},
            {"key": "maximum_additional_ricochets", "value": 3, "unit": "count"}
          ],
          "rule": "적중 대상에게 출혈 1중첩을 부여하고 도탄 수를 1 늘린다. 최대 +3이다."
        },
        {
          "ordinal": 4,
          "logic_id": "apply_and_copy_burn_to_next_target",
          "parameters": [],
          "rule": "적중 대상에게 화상을 부여하고 남은 화상을 다음 도탄 대상에게 복제한다."
        },
        {
          "ordinal": 5,
          "logic_id": "kill_small_arrows",
          "parameters": [
            {"key": "damage_multiplier", "value": 1, "unit": "multiplier"},
            {"key": "arrows_per_kill", "value": 3, "unit": "count"},
            {"key": "maximum_arrows_per_cast", "value": 9, "unit": "count"}
          ],
          "rule": "원본 도탄으로 적을 처치하면 주변의 서로 다른 적을 향해 기본 위력 추적 화살을 최대 3발 발사한다."
        },
        {
          "ordinal": 6,
          "logic_id": "original_ricochet_kill_new_chain",
          "parameters": [{"key": "new_chain_targets", "value": 3, "unit": "count"}],
          "rule": "원본 도탄 화살로 적을 처치하면 새 화살이 최대 3명에게 다시 도탄한다."
        },
