#ifndef HS_TERRAIN_HISTOGRAM_ABI_HLSLI
#define HS_TERRAIN_HISTOGRAM_ABI_HLSLI

#define HS_TERRAIN_HISTOGRAM_WIDTH 256
#define HS_TERRAIN_HISTOGRAM_MIPS 12
#define HS_TERRAIN_HISTOGRAM_LAYERS 4
// Each component has consecutive fractional-LOD rows of RGB contribution.
#define HS_TERRAIN_HISTOGRAM_MEAN_ROW (3 * HS_TERRAIN_HISTOGRAM_MIPS)
#define HS_TERRAIN_HISTOGRAM_HEIGHT (HS_TERRAIN_HISTOGRAM_MEAN_ROW + 1)

#endif
